<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
<Item class="Workspace" referent="RBX00000001"><Properties><string name="Name">Workspace</string></Properties></Item>
<Item class="ReplicatedStorage" referent="RBX00000015"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX00000014"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">Characters</string><ProtectedString name="Source"><![CDATA[-- Builds any of the 12 characters by id.
--   Characters.build(id)            -> walking model with a Humanoid (server, red carpet)
--   Characters.buildStatic(id, k)   -> anchored model, no Humanoid (tanks, sphere, intro)
local ItemData = require(script.Parent.ItemData)

local Characters = {}
local builders: { [string]: () -> Model } = {}

for _, child in script:GetChildren() do
	if child:IsA("ModuleScript") then
		builders[child.Name] = require(child) :: any
	end
end

local cache: { [string]: Model } = {}

local function template(id: string): Model
	local m = cache[id]
	if not m then
		local b = builders[id]
		assert(b, "No character builder for " .. tostring(id))
		m = b()
		local scale = ItemData.byId[id] and ItemData.byId[id].scale or 1
		if scale ~= 1 then
			local hip = m:GetAttribute("Hip") :: number
			m:ScaleTo(scale)
			m:SetAttribute("Hip", hip * scale)
			local hum = m:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.HipHeight = (hip - 1) * scale
			end
		end
		cache[id] = m
	end
	return m
end

function Characters.build(id: string): Model
	return template(id):Clone()
end

-- A model that does not walk by physics. Its joints still move, so it can be animated
-- by the Gait module while we move it with PivotTo.
function Characters.buildStatic(id: string, scale: number?): Model
	local m = template(id):Clone()
	local hum = m:FindFirstChildOfClass("Humanoid")
	if hum then
		hum:Destroy()
	end
	local root = m.PrimaryPart :: BasePart
	root.Anchored = true
	local k = scale or 1
	if k ~= 1 then
		local hip = m:GetAttribute("Hip") :: number
		m:ScaleTo(m:GetScale() * k)
		m:SetAttribute("Hip", hip * k)
	end
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
		end
	end
	return m
end

-- Puts a model so its feet stand on groundPos, facing yaw (radians).
function Characters.place(m: Model, groundPos: Vector3, yaw: number)
	local hip = (m:GetAttribute("Hip") :: number?) or 2
	m:PivotTo(CFrame.new(groundPos + Vector3.new(0, hip, 0)) * CFrame.Angles(0, yaw, 0))
end

return Characters
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">BlueCrystal</string><ProtectedString name="Source"><![CDATA[-- Blue Crystal (Epic): the millionaire. Faceted glowing blue crystal body and spiky crystal
-- head, gold crown with blue gems, black "$" sunglasses in gold frames, big smile,
-- white fur collar, royal blue cape with a diamond emblem, gold "$" chain,
-- gold bracelets and white-blue-gold "$" sneakers.
local Rig = require(script.Parent.Parent.Rig)
local C, V = Color3.fromRGB, Vector3.new

local CRY = C(80, 165, 255)
local CRY_L = C(165, 225, 255)
local CRY_D = C(35, 95, 225)
local GOLD = C(245, 190, 45)
local WHITE = C(250, 250, 255)
local NAVY = C(25, 35, 140)
local NEON = Enum.Material.Neon
local GLASS = Enum.Material.Glass
local METAL = Enum.Material.Metal

local function dollar(part: BasePart, color: Color3)
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Front
	sg.LightInfluence = 0
	sg.PixelsPerStud = 60
	sg.Parent = part
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Text = "$"
	t.TextScaled = true
	t.Font = Enum.Font.FredokaOne
	t.TextColor3 = color
	t.Parent = sg
end

return function(): Model
	local r = Rig.new("BlueCrystal", 2.1)
	r:symJoint("LegL", V(-0.55, 1.75, 0))
	r:symJoint("ArmL", V(-1.2, 3.5, 0))
	r:joint("Head", V(0, 3.9, 0))
	r:joint("Cape", V(0, 3.7, 0.85))

	-- sneakers
	r:sym({ sz = V(1.0, 0.72, 1.42), p = V(-0.55, 0.4, -0.15), c = WHITE, j = "LegL" })
	r:sym({ sz = V(1.05, 0.26, 1.5), p = V(-0.55, 0.14, -0.15), c = GOLD, m = METAL, j = "LegL" })
	r:sym({ sz = V(0.85, 0.3, 0.9), p = V(-0.55, 0.62, 0.15), c = NAVY, j = "LegL" })
	local tongue = r:add({ s = "box", sz = V(0.36, 0.36, 0.06), p = V(-0.55, 0.62, -0.74), c = GOLD, j = "LegL" })
	dollar(tongue, WHITE)
	local tongue2 = r:add({ s = "box", sz = V(0.36, 0.36, 0.06), p = V(0.55, 0.62, -0.74), c = GOLD, j = "LegR" })
	dollar(tongue2, WHITE)
	r:sym({ sz = V(0.6, 1.25, 0.6), p = V(-0.55, 1.2, 0), c = CRY, m = GLASS, t = 0.05, j = "LegL" })

	-- faceted crystal body with a glowing core
	r:add({ sz = V(1.5, 1.6, 1.1), p = V(0, 2.85, 0), c = CRY_L, m = NEON, t = 0.25 })
	r:add({ sz = V(2.0, 2.1, 1.6), p = V(0, 2.85, 0), c = CRY, m = GLASS, t = 0.12 })
	local rng = Random.new(11)
	for i = 1, 14 do
		local a = rng:NextNumber(0, math.pi * 2)
		local y = rng:NextNumber(2.0, 3.7)
		r:add({ s = "box", sz = V(0.75, 0.75, 0.4), p = V(math.sin(a) * 0.9, y, math.cos(a) * 0.68), r = V(rng:NextNumber(0, 90), math.deg(a), 45), c = (i % 3 == 0) and CRY_D or ((i % 3 == 1) and CRY_L or CRY), m = GLASS, t = 0.1 })
	end

	-- gold "$" chain
	for i = -5, 5 do
		local x = i * 0.15
		r:add({ s = "ball", sz = V(0.14, 0, 0), p = V(x, 3.45 + x * x * 0.55, -0.82 + math.abs(x) * 0.1), c = GOLD, m = METAL })
	end
	local pendant = r:add({ s = "box", sz = V(0.75, 0.95, 0.16), p = V(0, 2.95, -0.98), c = GOLD, m = METAL, refl = 0.2 })
	dollar(pendant, WHITE)

	-- white fur collar
	r:ring(12, function(i, a)
		return { sz = V(0.7, 0.55, 0.6), p = V(math.sin(a) * 1.05, 3.75, math.cos(a) * 0.95), c = WHITE }
	end)

	-- royal blue cape
	r:add({ s = "box", sz = V(2.6, 2.9, 0.15), p = V(0, 2.2, 1.2), r = V(8, 0, 0), c = NAVY, j = "Cape" })
	r:add({ s = "box", sz = V(2.66, 0.2, 0.2), p = V(0, 0.8, 1.4), r = V(8, 0, 0), c = GOLD, m = METAL, j = "Cape" })
	r:sym({ s = "box", sz = V(0.16, 2.8, 0.2), p = V(-1.25, 2.2, 1.23), r = V(8, 0, 0), c = GOLD, m = METAL, j = "Cape" })
	r:add({ s = "box", sz = V(0.62, 0.62, 0.1), p = V(0, 2.35, 1.34), r = V(8, 0, 45), c = CRY_L, m = NEON, j = "Cape" })
	r:sym({ sz = V(0.25, 0.7, 0.08), p = V(-0.6, 2.3, 1.34), r = V(8, 0, -25), c = GOLD, m = METAL, j = "Cape" })

	-- arms
	r:sym({ sz = V(0.72, 1.3, 0.72), p = V(-1.35, 2.85, 0), r = V(0, 0, -8), c = CRY, m = GLASS, t = 0.08, j = "ArmL" })
	r:sym({ s = "cyl", sz = V(0.8, 0.22, 0.8), p = V(-1.42, 2.3, 0), c = GOLD, m = METAL, j = "ArmL" })
	r:sym({ sz = V(0.82, 0.75, 0.82), p = V(-1.45, 1.9, 0), c = CRY_L, m = GLASS, t = 0.08, j = "ArmL" })

	-- spiky crystal head
	r:add({ sz = V(1.4, 1.3, 1.2), p = V(0, 4.9, 0), c = CRY_L, m = NEON, t = 0.3, j = "Head" })
	r:add({ sz = V(2.0, 1.9, 1.8), p = V(0, 4.9, 0), c = CRY, m = GLASS, t = 0.1, j = "Head" })
	for i = 1, 11 do
		local a = math.rad(55 + (i - 1) * 25)
		r:add({ s = "box", sz = V(0.42, 1.35, 0.42), p = V(math.sin(a) * 1.0, 5.1 + (i % 2) * 0.2, math.cos(a) * 0.9), r = V(42, math.deg(a), 45), c = (i % 2 == 0) and CRY_L or CRY, m = GLASS, t = 0.1, j = "Head" })
	end
	for _, d in { V(-0.45, 5.85, 0.1), V(0.45, 5.85, 0.1), V(0, 5.95, 0.45) } do
		r:add({ s = "box", sz = V(0.35, 0.9, 0.35), p = d, r = V(10, 45, d.X * 30), c = CRY_L, m = GLASS, t = 0.1, j = "Head" })
	end
	-- smile
	r:add({ sz = V(0.95, 0.55, 0.16), p = V(0, 4.4, -0.88), c = C(40, 15, 40), j = "Head" })
	r:add({ sz = V(0.5, 0.28, 0.12), p = V(0, 4.25, -0.93), c = C(255, 120, 150), j = "Head" })
	r:add({ s = "box", sz = V(0.6, 0.1, 0.05), p = V(0, 4.6, -0.95), c = WHITE, j = "Head" })
	-- "$" sunglasses
	for _, x in { -0.45, 0.45 } do
		r:add({ sz = V(0.85, 0.65, 0.12), p = V(x, 4.95, -0.9), c = GOLD, m = METAL, j = "Head" })
		local lens = r:add({ s = "box", sz = V(0.62, 0.48, 0.06), p = V(x, 4.95, -0.98), c = C(10, 10, 15), j = "Head" })
		dollar(lens, C(255, 205, 50))
	end
	r:add({ s = "box", sz = V(0.3, 0.08, 0.08), p = V(0, 5.05, -0.95), c = GOLD, m = METAL, j = "Head" })
	r:sym({ s = "box", sz = V(0.08, 0.08, 0.9), p = V(-0.88, 5.0, -0.5), c = GOLD, m = METAL, j = "Head" })
	-- gold crown with blue gems
	r:add({ s = "cyl", sz = V(1.5, 0.42, 1.5), p = V(0, 6.05, 0), c = GOLD, m = METAL, refl = 0.15, j = "Head" })
	r:ring(6, function(i, a)
		return { sz = V(0.28, 0.75, 0.28), p = V(math.sin(a) * 0.72, 6.5, math.cos(a) * 0.72), c = GOLD, m = METAL, j = "Head" }
	end)
	r:ring(6, function(i, a)
		return { s = "box", sz = V(0.2, 0.2, 0.08), p = V(math.sin(a) * 0.77, 6.05, math.cos(a) * 0.77), r = V(0, math.deg(a), 45), c = CRY_L, m = NEON, j = "Head" }
	end)

	r:emitter("Body", { Rate = 6, Lifetime = NumberRange.new(0.8, 1.4), Speed = NumberRange.new(0.5, 1.5), SpreadAngle = Vector2.new(180, 180), Size = NumberSequence.new(0.3, 0), Color = ColorSequence.new(CRY_L, WHITE) })
	r:light("Body", CRY, 1.2, 10)
	return r:finish("BlueCrystal", "strut")
end
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">CosmicMeteor</string><ProtectedString name="Source"><![CDATA[-- Cosmic Meteor (Epic): a round rocky meteor with craters, glowing orange-purple galaxy
-- cracks, little golden stars, big purple eyes with sparkles, a fierce little grin with
-- fangs, stubby arms and legs, and purple-orange flames blazing off the top.
local Rig = require(script.Parent.Parent.Rig)
local C, V = Color3.fromRGB, Vector3.new

local ROCK = C(72, 64, 82)
local ROCK2 = C(55, 48, 64)
local GALAXY = C(165, 70, 255)
local GALAXY2 = C(90, 120, 255)
local CRACK = C(255, 140, 40)
local STAR = C(255, 215, 70)
local NEON = Enum.Material.Neon
local SLATE = Enum.Material.Slate

local CENTER = V(0, 2.65, 0)
local RAD = 1.5

-- point on the ball surface, and a rotation that faces outward
local function onBall(dir: Vector3, out: number): (Vector3, Vector3)
	dir = dir.Unit
	local p = CENTER + dir * (RAD + out)
	local rx = -math.deg(math.asin(dir.Y))
	local ry = math.deg(math.atan2(dir.X, dir.Z))
	return p, V(rx, ry, 0)
end

local function avoidFace(dir: Vector3): boolean
	-- keep the front (where the face is) clean
	return dir.Unit.Z < -0.55 and math.abs(dir.Unit.Y) < 0.6
end

return function(): Model
	local r = Rig.new("CosmicMeteor", 1.9)
	r:symJoint("LegL", V(-0.6, 1.3, 0))
	r:symJoint("ArmL", V(-1.45, 2.55, 0))
	r:joint("Flame", V(0, 3.9, 0.3))

	r:add({ s = "ball", sz = V(RAD * 2, 0, 0), p = CENTER, c = ROCK, m = SLATE })
	local rng = Random.new(21)
	-- craters
	for _ = 1, 16 do
		local d = V(rng:NextNumber(-1, 1), rng:NextNumber(-1, 1), rng:NextNumber(-1, 1))
		if d.Magnitude > 0.2 and not avoidFace(d) then
			local p, rot = onBall(d, -0.08)
			local s = rng:NextNumber(0.35, 0.65)
			r:add({ s = "cyl", sz = V(s + 0.12, 0.14, s + 0.12), p = p, r = rot + V(90, 0, 0), c = ROCK })
			r:add({ s = "cyl", sz = V(s, 0.16, s), p = p, r = rot + V(90, 0, 0), c = ROCK2 })
		end
	end
	-- galaxy patches and glowing cracks
	for i = 1, 26 do
		local d = V(rng:NextNumber(-1, 1), rng:NextNumber(-1, 1), rng:NextNumber(-1, 1))
		if d.Magnitude > 0.2 and not avoidFace(d) then
			local p, rot = onBall(d, -0.02)
			if i % 3 == 0 then
				r:add({ sz = V(0.7, 0.5, 0.12), p = p, r = rot + V(0, 0, rng:NextNumber(0, 180)), c = (i % 2 == 0) and GALAXY or GALAXY2, m = NEON })
			else
				r:add({ s = "box", sz = V(0.06, rng:NextNumber(0.4, 0.8), 0.06), p = p, r = rot + V(0, 0, rng:NextNumber(0, 180)), c = CRACK, m = NEON })
			end
		end
	end
	-- golden stars
	for _, d in { V(0.9, -0.4, -0.5), V(-0.8, 0.3, 0.6), V(0.7, 0.6, 0.5), V(-0.95, -0.5, -0.2), V(0.1, -0.7, 0.8) } do
		local p, rot = onBall(d, 0.02)
		r:add({ s = "box", sz = V(0.32, 0.32, 0.08), p = p, r = rot + V(0, 0, 45), c = STAR, m = NEON })
		r:add({ s = "box", sz = V(0.32, 0.32, 0.08), p = p, r = rot, c = STAR, m = NEON })
	end

	-- face
	r:eye(V(-0.55, 2.9, -1.32), 0.8, C(165, 60, 235), nil, { glow = true })
	r:eye(V(0.55, 2.9, -1.32), 0.8, C(165, 60, 235), nil, { glow = true })
	r:sym({ sz = V(0.7, 0.24, 0.3), p = V(-0.55, 3.42, -1.28), r = V(0, 0, -20), c = ROCK2 })
	r:sym({ sz = V(0.32, 0.18, 0.08), p = V(-0.9, 2.45, -1.2), c = C(255, 130, 160) })
	r:add({ sz = V(0.7, 0.48, 0.2), p = V(0, 2.2, -1.43), c = C(60, 10, 20) })
	r:add({ sz = V(0.4, 0.22, 0.12), p = V(0, 2.1, -1.5), c = C(255, 110, 120) })
	r:sym({ sz = V(0.12, 0.22, 0.08), p = V(-0.18, 2.37, -1.52), c = C(255, 255, 255) })

	-- stubby arms and legs
	r:sym({ sz = V(0.8, 0.95, 0.8), p = V(-1.65, 2.2, -0.1), r = V(0, 0, -20), c = ROCK, m = SLATE, j = "ArmL" })
	r:sym({ sz = V(0.3, 0.3, 0.1), p = V(-1.75, 2.1, -0.5), c = GALAXY, m = NEON, j = "ArmL" })
	r:sym({ sz = V(0.8, 0.9, 0.85), p = V(-0.6, 0.78, -0.05), c = ROCK, m = SLATE, j = "LegL" })
	r:sym({ sz = V(0.98, 0.45, 1.15), p = V(-0.6, 0.25, -0.2), c = ROCK2, m = SLATE, j = "LegL" })
	r:sym({ s = "box", sz = V(0.06, 0.35, 0.06), p = V(-0.45, 0.8, -0.45), r = V(0, 0, 20), c = CRACK, m = NEON, j = "LegL" })

	-- blazing flames on top
	r:add({ sz = V(1.0, 1.5, 1.0), p = V(0, 4.25, 0.45), r = V(25, 0, 0), c = C(255, 140, 30), m = NEON, j = "Flame" })
	r:add({ sz = V(0.75, 1.7, 0.75), p = V(-0.45, 4.45, 0.7), r = V(32, 0, 18), c = GALAXY, m = NEON, j = "Flame" })
	r:add({ sz = V(0.65, 1.35, 0.65), p = V(0.5, 4.35, 0.62), r = V(30, 0, -15), c = C(255, 200, 60), m = NEON, j = "Flame" })
	r:add({ sz = V(0.45, 1.1, 0.45), p = V(0.05, 4.9, 1.0), r = V(45, 0, 0), c = C(255, 110, 220), m = NEON, j = "Flame" })
	local fire = Instance.new("Fire")
	fire.Color = C(255, 120, 40)
	fire.SecondaryColor = GALAXY
	fire.Size = 4
	fire.Heat = 6
	fire.Parent = r.joints.Flame

	r:emitter("Flame", { Rate = 8, Lifetime = NumberRange.new(0.8, 1.5), Speed = NumberRange.new(1, 2.5), SpreadAngle = Vector2.new(40, 40), Size = NumberSequence.new(0.3, 0), Color = ColorSequence.new(STAR, C(255, 140, 255)), EmissionDirection = Enum.NormalId.Top })
	r:light("Body", GALAXY, 1.3, 10)
	return r:finish("CosmicMeteor", "tiny")
end
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">DrippoBloxino</string><ProtectedString name="Source"><![CDATA[-- Drippo Bloxino (Super Rare): a stylish blocky boy. Messy brown hair, white sunglasses
-- on his head, a little silver crown, white headphones with blue stars, blue eyes and a
-- cheeky smile with a band-aid, black-and-white jacket over a blue crown shirt, silver
-- chains, black cargo pants, blue-white sneakers - and his phone, always in his hand.
local Rig = require(script.Parent.Parent.Rig)
local C, V = Color3.fromRGB, Vector3.new

local SKIN = C(250, 205, 160)
local HAIR = C(110, 65, 35)
local HAIR2 = C(135, 82, 45)
local BLACK = C(28, 28, 34)
local GREY = C(215, 218, 225)
local BLUE = C(40, 95, 225)
local WHITE = C(250, 250, 255)
local SILVER = C(200, 205, 215)
local NEON = Enum.Material.Neon
local METAL = Enum.Material.Metal

return function(): Model
	local r = Rig.new("DrippoBloxino", 2.0)
	r:symJoint("LegL", V(-0.5, 2.0, 0))
	r:symJoint("ArmL", V(-1.45, 3.8, 0))
	r:joint("Head", V(0, 4.0, 0))

	-- sneakers
	r:sym({ s = "box", sz = V(1.02, 0.55, 1.45), p = V(-0.5, 0.32, -0.15), c = WHITE, j = "LegL" })
	r:sym({ s = "box", sz = V(1.06, 0.18, 1.5), p = V(-0.5, 0.09, -0.15), c = GREY, j = "LegL" })
	r:sym({ s = "box", sz = V(1.04, 0.3, 0.7), p = V(-0.5, 0.45, 0.2), c = C(25, 40, 110), j = "LegL" })
	r:sym({ s = "box", sz = V(0.3, 0.3, 0.06), p = V(-0.5, 0.45, -0.88), r = V(0, 0, 45), c = BLUE, m = NEON, j = "LegL" })
	-- cargo pants
	r:sym({ s = "box", sz = V(0.95, 1.55, 1.0), p = V(-0.5, 1.33, 0), c = BLACK, j = "LegL" })
	r:sym({ s = "box", sz = V(0.18, 0.55, 0.6), p = V(-1.03, 1.25, 0), c = C(45, 45, 55), j = "LegL" })
	r:sym({ s = "box", sz = V(0.06, 1.2, 0.08), p = V(-0.98, 1.4, -0.35), c = BLUE, j = "LegL" })
	-- chain on the pants
	for k = 0, 5 do
		r:add({ s = "ball", sz = V(0.12, 0, 0), p = V(-0.9 + k * 0.05, 1.85 - k * 0.12, -0.55), c = SILVER, m = METAL, j = "LegL" })
	end

	-- torso: blue shirt with a crown, black-white open jacket, hood
	r:add({ s = "box", sz = V(2.0, 2.0, 1.0), p = V(0, 3.0, 0), c = BLUE })
	r:add({ s = "box", sz = V(0.65, 0.3, 0.05), p = V(0, 3.15, -0.52), c = WHITE })
	for k = -1, 1 do
		r:add({ s = "box", sz = V(0.15, 0.22, 0.05), p = V(k * 0.24, 3.38, -0.52), c = WHITE })
	end
	r:sym({ s = "box", sz = V(0.62, 2.0, 1.06), p = V(-0.7, 3.0, 0), c = BLACK })
	r:sym({ s = "box", sz = V(0.06, 1.9, 0.08), p = V(-0.38, 3.0, -0.54), c = WHITE })
	r:add({ s = "box", sz = V(0.4, 0.4, 0.05), p = V(-0.72, 3.4, -0.54), c = WHITE })
	r:add({ s = "box", sz = V(0.12, 0.45, 0.05), p = V(0.75, 3.2, -0.54), r = V(0, 0, 25), c = WHITE })
	r:add({ s = "box", sz = V(2.06, 0.28, 1.08), p = V(0, 2.1, 0), c = BLUE })
	r:add({ s = "box", sz = V(2.08, 0.08, 1.1), p = V(0, 2.1, 0), c = WHITE })
	r:add({ sz = V(2.05, 0.75, 1.3), p = V(0, 4.05, 0.32), c = GREY })
	r:add({ s = "box", sz = V(0.9, 0.06, 0.06), p = V(0, 3.95, -0.45), c = SILVER, m = METAL })
	for i = -4, 4 do
		local x = i * 0.1
		r:add({ s = "ball", sz = V(0.1, 0, 0), p = V(x, 3.6 + x * x * 1.2, -0.55), c = SILVER, m = METAL })
	end
	r:add({ s = "box", sz = V(0.18, 0.22, 0.05), p = V(0, 3.45, -0.57), c = SILVER, m = METAL })
	-- crossbody bag on the back
	r:add({ s = "box", sz = V(1.0, 0.6, 0.35), p = V(0, 2.65, 0.65), c = BLACK })
	r:add({ s = "box", sz = V(0.12, 2.2, 0.06), p = V(0, 3.1, 0.53), r = V(0, 0, 40), c = BLACK })

	-- arms: white short sleeves, skin, bracelet and a phone in the right hand
	r:sym({ s = "box", sz = V(1.0, 0.9, 1.05), p = V(-1.5, 3.45, 0), c = GREY, j = "ArmL" })
	r:sym({ s = "box", sz = V(0.25, 0.4, 0.06), p = V(-1.5, 3.5, -0.54), r = V(0, 0, 20), c = BLACK, j = "ArmL" })
	r:sym({ s = "box", sz = V(0.9, 1.25, 0.9), p = V(-1.5, 2.4, 0), c = SKIN, j = "ArmL" })
	r:add({ s = "box", sz = V(0.95, 0.2, 0.95), p = V(-1.5, 2.15, 0), c = SILVER, m = METAL, j = "ArmL" })
	r:add({ s = "box", sz = V(0.95, 0.22, 0.95), p = V(1.5, 2.15, 0), c = BLACK, j = "ArmR" })
	r:add({ s = "box", sz = V(0.55, 0.1, 0.9), p = V(1.5, 1.72, -0.3), c = BLACK, j = "ArmR" })
	r:add({ s = "box", sz = V(0.47, 0.02, 0.78), p = V(1.5, 1.78, -0.3), c = C(90, 180, 255), m = NEON, j = "ArmR" })

	-- head
	r:add({ s = "box", sz = V(1.7, 1.6, 1.5), p = V(0, 4.85, 0), c = SKIN, j = "Head" })
	r:eye(V(-0.38, 4.85, -0.74), 0.48, C(40, 110, 230), "Head", { tall = 1.3 })
	r:eye(V(0.38, 4.85, -0.74), 0.48, C(40, 110, 230), "Head", { tall = 1.3 })
	r:add({ sz = V(0.5, 0.25, 0.08), p = V(0, 4.38, -0.76), c = C(120, 30, 40), j = "Head" })
	r:add({ s = "box", sz = V(0.08, 0.1, 0.04), p = V(0.12, 4.46, -0.8), c = WHITE, j = "Head" })
	r:sym({ sz = V(0.3, 0.18, 0.06), p = V(-0.62, 4.5, -0.75), c = C(255, 150, 140), j = "Head" })
	r:add({ s = "box", sz = V(0.38, 0.14, 0.04), p = V(-0.6, 4.55, -0.77), r = V(0, 0, 30), c = C(235, 200, 160), j = "Head" })
	-- messy spiky hair
	r:add({ s = "box", sz = V(1.85, 0.55, 1.65), p = V(0, 5.72, 0.02), c = HAIR, j = "Head" })
	local rng = Random.new(4)
	for i = 1, 16 do
		local a = (i / 16) * math.pi * 2
		r:add({ sz = V(0.7, 0.55, 0.85), p = V(math.sin(a) * 0.8, 5.9 + rng:NextNumber(0, 0.35), math.cos(a) * 0.72), r = V(rng:NextNumber(-30, 30), math.deg(a), rng:NextNumber(-30, 30)), c = (i % 2 == 0) and HAIR or HAIR2, j = "Head" })
	end
	for k = -2, 2 do
		r:add({ sz = V(0.45, 0.6, 0.35), p = V(k * 0.35, 5.45, -0.72), r = V(25, 0, k * -12), c = (k % 2 == 0) and HAIR2 or HAIR, j = "Head" })
	end
	r:add({ sz = V(1.7, 1.0, 0.6), p = V(0, 5.2, 0.7), c = HAIR, j = "Head" })
	-- white sunglasses pushed up
	r:add({ s = "box", sz = V(1.7, 0.36, 0.12), p = V(0, 5.88, -0.78), c = WHITE, j = "Head" })
	r:sym({ s = "box", sz = V(0.6, 0.26, 0.06), p = V(-0.4, 5.88, -0.85), c = C(20, 20, 25), j = "Head" })
	-- small silver crown
	r:add({ s = "cyl", sz = V(0.65, 0.22, 0.65), p = V(-0.45, 6.3, 0.05), r = V(0, 0, 15), c = SILVER, m = METAL, j = "Head" })
	r:ring(4, function(i, a)
		return { s = "ball", sz = V(0.14, 0, 0), p = V(-0.45 + math.sin(a) * 0.3, 6.5, 0.05 + math.cos(a) * 0.3), c = SILVER, m = METAL, j = "Head" }
	end)
	-- headphones with blue stars
	r:add({ s = "box", sz = V(0.25, 0.25, 0.4), p = V(0, 6.2, -0.05), c = WHITE, j = "Head" })
	r:sym({ s = "box", sz = V(0.25, 0.9, 0.4), p = V(-0.95, 5.8, -0.05), r = V(0, 0, -20), c = WHITE, j = "Head" })
	r:sym({ s = "cyl", sz = V(0.95, 0.35, 0.95), p = V(-0.98, 4.85, 0), r = V(0, 0, 90), c = WHITE, j = "Head" })
	r:sym({ s = "box", sz = V(0.3, 0.3, 0.05), p = V(-1.17, 4.85, 0), r = V(0, 90, 45), c = BLUE, m = NEON, j = "Head" })
	r:sym({ s = "box", sz = V(0.3, 0.3, 0.05), p = V(-1.17, 4.85, 0), r = V(0, 90, 0), c = BLUE, m = NEON, j = "Head" })
	-- star clip in the hair
	r:add({ s = "box", sz = V(0.28, 0.28, 0.06), p = V(0.65, 5.5, -0.78), r = V(0, 0, 45), c = BLUE, m = NEON, j = "Head" })

	r:emitter("Body", { Rate = 3, Lifetime = NumberRange.new(0.8, 1.2), Speed = NumberRange.new(0.3, 0.8), SpreadAngle = Vector2.new(180, 180), Size = NumberSequence.new(0.25, 0), Color = ColorSequence.new(C(120, 170, 255)) })
	r:light("Body", C(90, 150, 255), 0.6, 8)
	return r:finish("DrippoBloxino", "phone")
end
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000005"><Properties><string name="Name">FrostyFangolini</string><ProtectedString name="Source"><![CDATA[-- Frosty Fangolini (Secret): a blocky white saber-tooth ice tiger with blue stripes,
-- glowing ice-crystal spikes along its back, glowing blue eyes, huge saber fangs, ice
-- claws, and a tail ending in an ice crystal. Snowflakes swirl around it.
local Rig = require(script.Parent.Parent.Rig)
local C, V = Color3.fromRGB, Vector3.new

local FUR = C(236, 242, 252)
local FUR2 = C(215, 225, 242)
local STRIPE = C(40, 95, 225)
local ICE = C(120, 215, 255)
local ICE2 = C(180, 240, 255)
local NEON = Enum.Material.Neon
local GLASS = Enum.Material.Glass

local function shard(r, p: Vector3, len: number, tilt: Vector3, j: string?, k: number)
	r:add({ s = "box", sz = V(0.45, len, 0.45), p = p, r = tilt + V(0, 45, 0), c = (k % 2 == 0) and ICE or ICE2, m = (k % 3 == 0) and NEON or GLASS, t = (k % 3 == 0) and 0 or 0.08, j = j })
end

return function(): Model
	local r = Rig.new("FrostyFangolini", 2.5)
	r:symJoint("LegFL", V(-0.8, 2.4, -1.35))
	r:symJoint("LegBL", V(-0.8, 2.4, 1.65))
	r:joint("Head", V(0, 3.5, -2.0))
	r:joint("Tail", V(0, 3.35, 2.3))

	-- body
	r:add({ s = "box", sz = V(2.2, 1.9, 4.2), p = V(0, 3.0, 0.2), c = FUR })
	r:add({ s = "box", sz = V(1.8, 0.45, 3.9), p = V(0, 2.1, 0.2), c = FUR2 })
	r:add({ s = "box", sz = V(2.3, 1.7, 0.9), p = V(0, 3.1, -1.6), c = FUR })
	-- blue stripes
	for k = 0, 6 do
		local z = -1.4 + k * 0.55
		r:sym({ s = "box", sz = V(0.06, 1.15, 0.22), p = V(-1.12, 3.15, z), r = V(18 * ((k % 2 == 0) and 1 or -1), 0, 0), c = STRIPE })
		r:add({ s = "box", sz = V(1.4, 0.06, 0.2), p = V(0, 3.96, z + 0.2), c = STRIPE })
	end
	-- ice spikes along the back
	for k = 0, 8 do
		local z = -1.9 + k * 0.5
		local len = 1.3 - math.abs(k - 3) * 0.12
		shard(r, V(0, 4.3 + len * 0.3, z), len, V(-20, 0, 0), nil, k)
		if k % 2 == 1 then
			shard(r, V(-0.5, 4.15, z), len * 0.6, V(-15, 0, 25), nil, k + 1)
			shard(r, V(0.5, 4.15, z), len * 0.6, V(-15, 0, -25), nil, k + 1)
		end
	end

	-- legs with ice claws
	for _, j in { "LegFL", "LegBL" } do
		local z = (j == "LegFL") and -1.35 or 1.65
		r:sym({ s = "box", sz = V(0.88, 1.75, 0.95), p = V(-0.8, 1.55, z), c = FUR, j = j })
		r:sym({ s = "box", sz = V(0.9, 0.08, 0.4), p = V(-0.8, 1.8, z - 0.2), r = V(20, 0, 0), c = STRIPE, j = j })
		r:sym({ s = "box", sz = V(1.1, 0.55, 1.25), p = V(-0.8, 0.28, z - 0.1), c = FUR2, j = j })
		for k = -1, 1 do
			r:sym({ s = "box", sz = V(0.18, 0.4, 0.18), p = V(-0.8 + k * 0.33, 0.25, z - 0.82), r = V(-35, 45, 0), c = ICE, m = NEON, j = j })
		end
	end

	-- head with saber fangs
	r:add({ s = "box", sz = V(1.75, 1.55, 1.55), p = V(0, 3.9, -2.5), c = FUR, j = "Head" })
	r:add({ s = "box", sz = V(1.05, 0.7, 0.75), p = V(0, 3.45, -3.25), c = FUR2, j = "Head" })
	r:add({ s = "box", sz = V(0.45, 0.28, 0.2), p = V(0, 3.75, -3.63), c = C(25, 25, 35), j = "Head" })
	r:add({ s = "box", sz = V(0.85, 0.42, 0.35), p = V(0, 3.0, -3.2), c = C(170, 25, 40), j = "Head" })
	r:add({ s = "box", sz = V(0.8, 0.15, 0.4), p = V(0, 2.75, -3.15), c = FUR2, j = "Head" })
	r:sym({ sz = V(0.22, 1.0, 0.22), p = V(-0.32, 2.8, -3.38), r = V(-8, 0, 5), c = C(250, 250, 245), j = "Head" })
	r:sym({ s = "box", sz = V(0.12, 0.2, 0.1), p = V(-0.12, 3.12, -3.4), c = C(250, 250, 245), j = "Head" })
	r:sym({ s = "box", sz = V(0.4, 0.2, 0.1), p = V(-0.42, 4.15, -3.29), r = V(0, 0, -15), c = ICE, m = NEON, j = "Head" })
	r:sym({ s = "box", sz = V(0.5, 0.08, 0.06), p = V(-0.45, 4.35, -3.3), r = V(0, 0, -20), c = STRIPE, j = "Head" })
	r:sym({ s = "box", sz = V(0.06, 0.45, 0.1), p = V(-0.7, 3.95, -3.29), r = V(0, 0, 25), c = STRIPE, j = "Head" })
	r:add({ s = "box", sz = V(0.12, 0.5, 0.08), p = V(0, 4.4, -3.29), c = STRIPE, j = "Head" })
	r:sym({ s = "box", sz = V(0.42, 0.48, 0.28), p = V(-0.68, 4.8, -2.4), c = FUR, j = "Head" })
	r:sym({ s = "box", sz = V(0.3, 0.2, 0.3), p = V(-0.68, 5.05, -2.4), c = STRIPE, j = "Head" })
	for k = -1, 1 do
		shard(r, V(k * 0.35, 4.95, -2.3), 0.7 - math.abs(k) * 0.2, V(-20, 0, k * -20), "Head", k + 2)
	end

	-- tail with an ice crystal tip
	r:add({ s = "box", sz = V(0.4, 0.4, 1.0), p = V(0, 3.45, 2.9), r = V(-20, 0, 0), c = FUR, j = "Tail" })
	r:add({ s = "box", sz = V(0.36, 0.36, 0.9), p = V(0, 3.95, 3.45), r = V(-50, 0, 0), c = FUR, j = "Tail" })
	r:add({ s = "box", sz = V(0.42, 0.08, 0.42), p = V(0, 3.65, 3.1), r = V(-20, 0, 0), c = STRIPE, j = "Tail" })
	for k = 0, 4 do
		local a = k / 5 * math.pi * 2
		shard(r, V(math.sin(a) * 0.15, 4.55, 3.75 + math.cos(a) * 0.15), 0.8, V(math.cos(a) * 25, 0, math.sin(a) * 25), "Tail", k)
	end

	-- swirling snowflakes
	r:emitter("Body", { Rate = 18, Lifetime = NumberRange.new(1.5, 2.5), Speed = NumberRange.new(0.5, 2), SpreadAngle = Vector2.new(180, 180), Acceleration = Vector3.new(0, -1.5, 0), RotSpeed = NumberRange.new(-90, 90), Size = NumberSequence.new(0.35, 0.1), Color = ColorSequence.new(C(255, 255, 255), ICE) })
	r:light("Body", ICE, 1.5, 12)
	return r:finish("FrostyFangolini", "quad")
end
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">GalaxyDragon</string><ProtectedString name="Source"><![CDATA[-- Galaxy Dragon (Secret): a blocky deep-purple dragon full of glowing galaxy patches and
-- stars, pale belly plates, glowing cyan eyes, crystal horns and back spikes, cyan
-- claws, big galaxy wings, and a crystal tail tip. It breathes fire.
local Rig = require(script.Parent.Parent.Rig)
local C, V = Color3.fromRGB, Vector3.new

local SCALE = C(72, 36, 135)
local SCALE2 = C(100, 48, 175)
local BELLY = C(205, 175, 225)
local PINK = C(255, 95, 225)
local BLUE = C(95, 155, 255)
local CYAN = C(95, 235, 255)
local HORN = C(195, 95, 255)
local MEMBRANE = C(170, 70, 235)
local NEON = Enum.Material.Neon
local GLASS = Enum.Material.Glass

local function crystal(r, p: Vector3, len: number, tilt: Vector3, j: string?, k: number)
	r:add({ s = "box", sz = V(0.42, len, 0.42), p = p, r = tilt + V(0, 45, 0), c = (k % 2 == 0) and HORN or PINK, m = (k % 3 == 0) and GLASS or NEON, t = (k % 3 == 0) and 0.05 or 0, j = j })
end

local function galaxyDots(r, center: Vector3, half: Vector3, count: number, seed: number, j: string?)
	local rng = Random.new(seed)
	local cols = { PINK, BLUE, C(255, 255, 255), CYAN }
	for i = 1, count do
		local side = rng:NextInteger(1, 3)
		local p = center + V(rng:NextNumber(-1, 1) * half.X, rng:NextNumber(-1, 1) * half.Y, rng:NextNumber(-1, 1) * half.Z)
		if side == 1 then
			p = V(center.X + half.X * (rng:NextNumber() < 0.5 and -1 or 1), p.Y, p.Z)
		elseif side == 2 then
			p = V(p.X, center.Y + half.Y, p.Z)
		end
		local s = rng:NextNumber(0.12, 0.35)
		r:add({ s = "box", sz = V(s, s, s), p = p, r = V(45, 45, 0), c = cols[(i % #cols) + 1], m = NEON, t = (i % 4 == 0) and 0.3 or 0, j = j })
	end
end

local function wing(r, j: string, side: number)
	-- side = -1 for left, +1 for right
	local base = V(side * 1.15, 4.35, -0.6)
	local spars = { { 150, 4.4 }, { 172, 4.0 }, { 195, 3.4 } }
	for k, s in spars do
		local ang = math.rad(s[1])
		local dir = V(math.cos(ang) * -side, math.sin(ang), 0)
		-- mirror so both wings spread outward
		dir = V(side * math.abs(dir.X), dir.Y, 0)
		local len = s[2]
		local mid = base + dir * (len / 2)
		local rz = math.deg(math.atan2(dir.Y, dir.X))
		r:add({ s = "box", sz = V(len, 0.24, 0.24), p = mid, r = V(0, 0, rz), c = SCALE, j = j })
		r:add({ s = "box", sz = V(0.3, 0.3, 0.3), p = base + dir * len, r = V(45, 0, 45), c = CYAN, m = NEON, j = j })
		-- membrane panel hanging below each spar
		local down = V(-dir.Y * side * -1, -math.abs(dir.X), 0).Unit
		local panelMid = mid + down * 0.75 + V(0, 0, 0.05)
		r:add({ s = "box", sz = V(len * 0.92, 1.5, 0.08), p = panelMid, r = V(0, 0, rz), c = MEMBRANE, m = NEON, t = 0.3, j = j })
		local rng = Random.new(30 + k + (side > 0 and 10 or 0))
		for _ = 1, 6 do
			local f = rng:NextNumber(0.15, 0.85)
			local o = rng:NextNumber(-0.5, 0.5)
			local p = base + dir * (len * f) + down * (0.75 + o)
			r:add({ s = "ball", sz = V(rng:NextNumber(0.08, 0.18), 0, 0), p = p + V(0, 0, -0.06), c = (rng:NextNumber() < 0.5) and C(255, 255, 255) or PINK, m = NEON, j = j })
		end
	end
	r:add({ sz = V(1.6, 0.6, 0.12), p = base + V(side * 1.2, -0.9, -0.02), c = C(255, 140, 235), m = NEON, t = 0.55, j = j })
end

return function(): Model
	local r = Rig.new("GalaxyDragon", 2.8)
	r:symJoint("LegFL", V(-0.85, 2.6, -1.4))
	r:symJoint("LegBL", V(-0.85, 2.6, 1.7))
	r:joint("Neck", V(0, 3.9, -1.9))
	r:joint("Head", V(0, 5.1, -2.85), "Neck")
	r:joint("Tail", V(0, 3.4, 2.4))
	r:joint("WingL", V(-1.15, 4.35, -0.6))
	r:joint("WingR", V(1.15, 4.35, -0.6))

	-- body
	r:add({ s = "box", sz = V(2.4, 2.1, 4.4), p = V(0, 3.3, 0.2), c = SCALE })
	r:add({ s = "box", sz = V(2.0, 0.4, 4.0), p = V(0, 4.4, 0.2), c = SCALE2 })
	galaxyDots(r, V(0, 3.3, 0.2), V(1.21, 1.05, 2.1), 40, 1)
	for k = 0, 5 do
		r:add({ s = "box", sz = V(1.5, 0.32, 0.3), p = V(0, 2.4 + k * 0.32, -2.0), c = BELLY })
	end
	r:add({ s = "box", sz = V(1.6, 0.3, 3.4), p = V(0, 2.22, 0.3), c = BELLY })
	for k = 0, 8 do
		crystal(r, V(0, 4.85 + (k % 2) * 0.15, -1.6 + k * 0.48), 1.05 - math.abs(k - 3) * 0.08, V(-25, 0, 0), nil, k)
	end

	-- legs with armour plates, cyan gems and claws
	for _, j in { "LegFL", "LegBL" } do
		local z = (j == "LegFL") and -1.4 or 1.7
		r:sym({ s = "box", sz = V(1.05, 1.95, 1.05), p = V(-0.85, 1.6, z), c = SCALE, j = j })
		r:sym({ s = "box", sz = V(1.15, 1.1, 1.15), p = V(-0.95, 2.4, z), r = V(0, 0, 0), c = SCALE2, j = j })
		r:sym({ s = "box", sz = V(0.32, 0.32, 0.08), p = V(-1.54, 2.4, z), r = V(0, 90, 45), c = CYAN, m = NEON, j = j })
		r:sym({ s = "box", sz = V(1.25, 0.55, 1.35), p = V(-0.85, 0.28, z - 0.1), c = SCALE2, j = j })
		for k = -1, 1 do
			r:sym({ s = "box", sz = V(0.2, 0.45, 0.2), p = V(-0.85 + k * 0.38, 0.25, z - 0.88), r = V(-35, 45, 0), c = CYAN, m = NEON, j = j })
		end
	end

	-- neck and head
	r:add({ s = "box", sz = V(1.25, 1.7, 1.25), p = V(0, 4.5, -2.35), r = V(25, 0, 0), c = SCALE, j = "Neck" })
	for k = 0, 3 do
		r:add({ s = "box", sz = V(0.9, 0.28, 0.2), p = V(0, 3.9 + k * 0.32, -2.85 - k * 0.12), r = V(25, 0, 0), c = BELLY, j = "Neck" })
	end
	r:add({ s = "box", sz = V(1.65, 1.35, 1.8), p = V(0, 5.4, -3.3), c = SCALE, j = "Head" })
	r:add({ s = "box", sz = V(1.15, 0.8, 1.25), p = V(0, 5.2, -4.35), c = SCALE2, j = "Head" })
	r:add({ s = "box", sz = V(1.05, 0.32, 1.15), p = V(0, 4.62, -4.2), r = V(12, 0, 0), c = SCALE, j = "Head" })
	r:add({ s = "box", sz = V(0.95, 0.28, 1.05), p = V(0, 4.85, -4.2), c = C(170, 25, 50), j = "Head" })
	for k = -2, 2 do
		r:add({ s = "box", sz = V(0.12, 0.2, 0.12), p = V(k * 0.2, 4.7, -4.85), c = C(255, 255, 250), j = "Head" })
	end
	r:sym({ s = "box", sz = V(0.12, 0.22, 0.12), p = V(-0.45, 4.95, -4.95), c = C(255, 255, 250), j = "Head" })
	r:sym({ s = "box", sz = V(0.1, 0.1, 0.06), p = V(-0.25, 5.45, -5.0), c = C(20, 10, 30), j = "Head" })
	r:sym({ s = "box", sz = V(0.45, 0.24, 0.12), p = V(-0.55, 5.72, -4.02), r = V(0, -20, -12), c = CYAN, m = NEON, j = "Head" })
	r:sym({ s = "box", sz = V(0.55, 0.12, 0.14), p = V(-0.55, 5.92, -4.0), r = V(0, -20, -20), c = SCALE2, j = "Head" })
	galaxyDots(r, V(0, 5.4, -3.2), V(0.83, 0.68, 0.7), 10, 2, "Head")
	-- crystal horns and crest
	r:sym({ s = "box", sz = V(0.32, 1.3, 0.32), p = V(-0.5, 6.4, -2.95), r = V(35, 45, -15), c = HORN, m = NEON, j = "Head" })
	r:sym({ s = "box", sz = V(0.24, 0.85, 0.24), p = V(-0.75, 6.1, -2.5), r = V(45, 45, -30), c = PINK, m = NEON, j = "Head" })
	r:sym({ s = "box", sz = V(0.22, 0.6, 0.22), p = V(-0.85, 5.6, -2.6), r = V(0, 45, -70), c = HORN, m = GLASS, j = "Head" })
	for k = 0, 2 do
		crystal(r, V(0, 6.2 - k * 0.1, -3.5 + k * 0.4), 0.6, V(-20, 0, 0), "Head", k)
	end
	-- fire breath from the mouth
	local mouth = Instance.new("Attachment")
	mouth.Name = "Mouth"
	mouth.Parent = r.joints.Head
	mouth.WorldPosition = V(0, 4.85, -4.9)
	local breath = Instance.new("ParticleEmitter")
	breath.Name = "Breath"
	breath.Texture = Rig.TEX.fire
	breath.Rate = 0
	breath.LightEmission = 1
	breath.EmissionDirection = Enum.NormalId.Front
	breath.Speed = NumberRange.new(14, 20)
	breath.SpreadAngle = Vector2.new(14, 14)
	breath.Lifetime = NumberRange.new(0.5, 0.8)
	breath.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 3) })
	breath.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
	breath.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, C(255, 230, 120)), ColorSequenceKeypoint.new(0.4, C(255, 110, 220)), ColorSequenceKeypoint.new(1, C(120, 60, 255)) })
	breath.Parent = mouth

	-- wings
	wing(r, "WingL", -1)
	wing(r, "WingR", 1)

	-- tail with a crystal tip
	r:add({ s = "box", sz = V(1.2, 1.1, 1.3), p = V(0, 3.2, 2.95), r = V(-8, 0, 0), c = SCALE, j = "Tail" })
	r:add({ s = "box", sz = V(0.9, 0.85, 1.2), p = V(0, 2.95, 3.95), r = V(-4, 0, 0), c = SCALE2, j = "Tail" })
	r:add({ s = "box", sz = V(0.65, 0.6, 1.1), p = V(0, 2.8, 4.85), c = SCALE, j = "Tail" })
	for k = 0, 3 do
		crystal(r, V(0, 3.8 - k * 0.25, 2.9 + k * 0.7), 0.7 - k * 0.08, V(-30, 0, 0), "Tail", k)
	end
	for k = 0, 4 do
		local a = k / 5 * math.pi * 2
		crystal(r, V(math.sin(a) * 0.2, 2.8 + math.cos(a) * 0.2, 5.55), 0.9, V(-90 + math.cos(a) * 25, 0, math.sin(a) * 25), "Tail", k)
	end

	r:emitter("Body", { Rate = 10, Lifetime = NumberRange.new(1, 2), Speed = NumberRange.new(0.5, 1.5), SpreadAngle = Vector2.new(180, 180), Size = NumberSequence.new(0.3, 0), Color = ColorSequence.new(PINK, BLUE) })
	r:light("Body", C(170, 90, 255), 2, 14)
	return r:finish("GalaxyDragon", "dragon")
end
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">Giraffe</string><ProtectedString name="Source"><![CDATA[-- Giraffe (Legendary, "Golden Giraffe"): golden-yellow giraffe with brown spots, big
-- shiny eyes with lashes, happy open smile, gold crown with emeralds, green cape with
-- gold trim and a golden leaf emblem, emerald brooch, white-gold sneakers.
local Rig = require(script.Parent.Parent.Rig)
local C, V = Color3.fromRGB, Vector3.new

local SKIN = C(248, 200, 95)
local SPOT = C(185, 112, 42)
local SNOUT = C(252, 228, 160)
local GOLD = C(245, 195, 50)
local GREEN = C(40, 110, 45)
local EMERALD = C(40, 220, 90)
local WHITE = C(252, 252, 250)
local NEON = Enum.Material.Neon
local METAL = Enum.Material.Metal

local function spots(r, center: Vector3, radius: Vector3, count: number, seed: number, j: string?)
	local rng = Random.new(seed)
	for _ = 1, count do
		local a = rng:NextNumber(0, math.pi * 2)
		local y = rng:NextNumber(-0.8, 0.8)
		local ring = math.sqrt(1 - y * y)
		local dir = V(math.sin(a) * ring, y, math.cos(a) * ring)
		local p = center + V(dir.X * radius.X, dir.Y * radius.Y, dir.Z * radius.Z) * 0.97
		local rx = -math.deg(math.asin(dir.Y))
		local ry = math.deg(math.atan2(dir.X, dir.Z))
		local s = rng:NextNumber(0.28, 0.42)
		r:add({ sz = V(s, s * 0.8, 0.1), p = p, r = V(rx, ry, rng:NextNumber(0, 90)), c = SPOT, j = j })
	end
end

return function(): Model
	local r = Rig.new("Giraffe", 2.3)
	r:symJoint("LegL", V(-0.5, 1.95, 0))
	r:symJoint("ArmL", V(-0.9, 3.45, 0))
	r:joint("Neck", V(0, 3.5, 0))
	r:joint("Head", V(0, 5.8, 0), "Neck")
	r:joint("Cape", V(0, 3.6, 0.6))

	-- sneakers
	r:sym({ sz = V(0.98, 0.72, 1.38), p = V(-0.5, 0.4, -0.15), c = WHITE, j = "LegL" })
	r:sym({ sz = V(1.03, 0.26, 1.45), p = V(-0.5, 0.14, -0.15), c = GOLD, m = METAL, j = "LegL" })
	r:sym({ sz = V(0.85, 0.3, 0.8), p = V(-0.5, 0.65, 0.15), c = GOLD, m = METAL, j = "LegL" })
	r:sym({ s = "box", sz = V(0.3, 0.2, 0.05), p = V(-0.98, 0.45, -0.1), r = V(0, 90, 0), c = GOLD, j = "LegL" })
	r:sym({ s = "box", sz = V(0.45, 0.06, 0.08), p = V(-0.5, 0.78, -0.45), c = WHITE, j = "LegL" })
	-- legs
	r:sym({ sz = V(0.5, 1.35, 0.5), p = V(-0.5, 1.3, 0), c = SKIN, j = "LegL" })
	r:sym({ sz = V(0.24, 0.2, 0.08), p = V(-0.5, 1.45, -0.24), c = SPOT, j = "LegL" })

	-- body
	r:add({ sz = V(1.75, 1.95, 1.45), p = V(0, 2.8, 0), c = SKIN })
	r:add({ sz = V(1.2, 1.4, 0.4), p = V(0, 2.7, -0.55), c = SNOUT })
	spots(r, V(0, 2.8, 0), V(0.87, 0.97, 0.72), 12, 3)

	-- long neck with a mane
	r:add({ sz = V(0.72, 2.7, 0.72), p = V(0, 4.65, 0), c = SKIN, j = "Neck" })
	spots(r, V(0, 4.65, 0), V(0.36, 1.2, 0.36), 7, 5, "Neck")
	for k = 0, 5 do
		r:add({ sz = V(0.2, 0.42, 0.3), p = V(0, 3.75 + k * 0.38, 0.38), c = SPOT, j = "Neck" })
	end

	-- head
	r:add({ sz = V(1.6, 1.4, 1.5), p = V(0, 6.4, 0), c = SKIN, j = "Head" })
	r:add({ sz = V(1.15, 0.85, 0.95), p = V(0, 6.05, -0.6), c = SNOUT, j = "Head" })
	r:sym({ sz = V(0.12, 0.08, 0.06), p = V(-0.2, 6.25, -1.06), c = C(120, 70, 30), j = "Head" })
	r:add({ sz = V(0.62, 0.38, 0.15), p = V(0, 5.84, -1.0), c = C(150, 30, 40), j = "Head" })
	r:add({ sz = V(0.35, 0.18, 0.1), p = V(0, 5.76, -1.04), c = C(255, 120, 130), j = "Head" })
	r:add({ s = "box", sz = V(0.26, 0.08, 0.04), p = V(0, 5.98, -1.06), c = WHITE, j = "Head" })
	r:eye(V(-0.42, 6.55, -0.62), 0.56, C(120, 70, 25), "Head")
	r:eye(V(0.42, 6.55, -0.62), 0.56, C(120, 70, 25), "Head")
	for k = 0, 2 do
		r:sym({ s = "box", sz = V(0.04, 0.2, 0.04), p = V(-0.62 - k * 0.07, 6.88 + k * 0.02, -0.6), r = V(0, 0, 30 + k * 15), c = C(40, 25, 15), j = "Head" })
	end
	r:sym({ sz = V(0.3, 0.2, 0.08), p = V(-0.68, 6.2, -0.58), c = C(255, 150, 120), j = "Head" })
	spots(r, V(0, 6.5, 0.1), V(0.8, 0.7, 0.72), 5, 9, "Head")
	-- ears
	r:sym({ sz = V(0.36, 0.72, 0.22), p = V(-0.88, 6.8, 0.05), r = V(0, 0, 60), c = SKIN, j = "Head" })
	r:sym({ sz = V(0.2, 0.5, 0.1), p = V(-0.9, 6.8, -0.04), r = V(0, 0, 60), c = C(255, 160, 160), j = "Head" })
	-- ossicones
	r:sym({ s = "cyl", sz = V(0.18, 0.62, 0.18), p = V(-0.32, 7.3, 0.15), c = C(200, 130, 60), j = "Head" })
	r:sym({ s = "ball", sz = V(0.32, 0, 0), p = V(-0.32, 7.65, 0.15), c = C(130, 75, 35), j = "Head" })
	-- crown with emeralds
	r:add({ s = "cyl", sz = V(0.95, 0.36, 0.95), p = V(0, 7.18, -0.15), c = GOLD, m = METAL, refl = 0.15, j = "Head" })
	r:ring(5, function(i, a)
		return { sz = V(0.2, 0.55, 0.2), p = V(math.sin(a) * 0.45, 7.55, -0.15 + math.cos(a) * 0.45), c = GOLD, m = METAL, j = "Head" }
	end)
	r:add({ s = "box", sz = V(0.22, 0.22, 0.08), p = V(0, 7.18, -0.64), r = V(0, 0, 45), c = EMERALD, m = NEON, j = "Head" })

	-- arms
	r:sym({ sz = V(0.45, 1.3, 0.45), p = V(-1.0, 2.75, 0), r = V(0, 0, -10), c = SKIN, j = "ArmL" })
	r:sym({ sz = V(0.52, 0.48, 0.52), p = V(-1.1, 2.0, 0), c = SNOUT, j = "ArmL" })

	-- green cape with gold trim, collar and emerald brooch
	r:ring(10, function(i, a)
		return { sz = V(0.6, 0.45, 0.5), p = V(math.sin(a) * 0.62, 3.65, math.cos(a) * 0.6), c = GREEN }
	end)
	r:add({ sz = V(0.62, 0.62, 0.22), p = V(0, 3.6, -0.7), c = GOLD, m = METAL })
	r:add({ sz = V(0.42, 0.5, 0.18), p = V(0, 3.6, -0.78), c = EMERALD, m = NEON })
	r:add({ s = "box", sz = V(2.4, 2.45, 0.12), p = V(0, 2.4, 0.95), r = V(8, 0, 0), c = GREEN, j = "Cape" })
	r:add({ s = "box", sz = V(2.46, 0.18, 0.16), p = V(0, 1.2, 1.12), r = V(8, 0, 0), c = GOLD, m = METAL, j = "Cape" })
	r:sym({ s = "box", sz = V(0.14, 2.4, 0.16), p = V(-1.17, 2.4, 0.97), r = V(8, 0, 0), c = GOLD, m = METAL, j = "Cape" })
	r:add({ s = "box", sz = V(0.06, 0.9, 0.06), p = V(0, 2.35, 1.07), r = V(8, 0, 0), c = GOLD, m = NEON, j = "Cape" })
	for k = 0, 2 do
		r:sym({ sz = V(0.38, 0.16, 0.06), p = V(-0.2, 2.1 + k * 0.28, 1.06 - k * 0.04), r = V(8, 0, 30), c = GOLD, m = NEON, j = "Cape" })
	end

	r:emitter("Body", { Rate = 5, Lifetime = NumberRange.new(1, 1.8), Speed = NumberRange.new(0.4, 1.2), SpreadAngle = Vector2.new(180, 180), Size = NumberSequence.new(0.3, 0), Color = ColorSequence.new(C(255, 230, 120), GOLD) })
	r:light("Body", C(255, 210, 110), 0.7, 9)
	return r:finish("Giraffe", "skip")
end
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">GrassAndFlowers</string><ProtectedString name="Source"><![CDATA[-- Grass and Flowers (Common): yellow smiling face inside big pink petals,
-- white flower crown, leafy green dress with glowing gold vines,
-- green leaf gloves and white sneakers with pink flowers.
local Rig = require(script.Parent.Parent.Rig)
local C, V = Color3.fromRGB, Vector3.new

local PINK = C(255, 105, 185)
local PINK_LIGHT = C(255, 175, 220)
local PINK_DARK = C(235, 70, 160)
local FACE = C(255, 205, 60)
local LEAF = C(70, 150, 50)
local LEAF2 = C(95, 175, 60)
local LEAF3 = C(55, 125, 40)
local GOLD = C(255, 215, 90)
local WHITE = C(255, 255, 255)
local NEON = Enum.Material.Neon

return function(): Model
	local r = Rig.new("GrassAndFlowers", 2.0)
	r:symJoint("LegL", V(-0.55, 1.7, 0))
	r:symJoint("ArmL", V(-1.15, 3.3, 0))
	r:joint("Head", V(0, 3.6, 0))
	r:joint("Halo", V(0, 2.6, 0))

	-- sneakers
	r:sym({ sz = V(0.95, 0.7, 1.35), p = V(-0.55, 0.38, -0.15), c = WHITE, j = "LegL" })
	r:sym({ sz = V(1.02, 0.25, 1.42), p = V(-0.55, 0.14, -0.15), c = C(255, 205, 225), j = "LegL" })
	r:sym({ sz = V(0.97, 0.22, 1.0), p = V(-0.55, 0.66, 0.05), c = LEAF2, j = "LegL" })
	r:sym({ s = "ball", sz = V(0.36, 0, 0), p = V(-0.55, 0.58, -0.74), c = PINK, j = "LegL" })
	r:sym({ s = "ball", sz = V(0.16, 0, 0), p = V(-0.55, 0.6, -0.9), c = C(255, 230, 80), j = "LegL" })
	r:sym({ sz = V(0.2, 0.08, 0.5), p = V(-0.55, 0.72, -0.35), c = PINK_LIGHT, j = "LegL" })
	-- legs
	r:sym({ sz = V(0.55, 1.2, 0.55), p = V(-0.55, 1.15, 0), c = LEAF3, j = "LegL" })

	-- leafy dress
	r:add({ sz = V(2.0, 2.2, 1.6), p = V(0, 2.6, 0), c = LEAF })
	r:ring(11, function(i, a)
		return { sz = V(0.75, 1.3, 0.35), p = V(math.sin(a) * 1.0, 1.95, math.cos(a) * 0.82), r = V(-28, math.deg(a), 0), c = (i % 2 == 0) and LEAF3 or LEAF }
	end)
	r:ring(9, function(i, a)
		a += 0.3
		return { sz = V(0.65, 1.1, 0.3), p = V(math.sin(a) * 0.95, 3.0, math.cos(a) * 0.78), r = V(-18, math.deg(a), 0), c = (i % 2 == 0) and LEAF2 or LEAF }
	end)
	-- little white flowers on the dress
	for _, p in { V(-0.5, 2.95, -0.82), V(0.55, 2.45, -0.88), V(0.05, 1.95, -1.0), V(-0.7, 1.9, -0.85), V(0.75, 3.15, -0.6), V(0, 2.9, 0.85) } do
		r:add({ s = "ball", sz = V(0.34, 0, 0), p = p, c = WHITE })
		r:add({ s = "ball", sz = V(0.14, 0, 0), p = p + V(0, 0, -0.14), c = C(255, 220, 70) })
	end
	-- glowing golden vines spiralling up the body
	for i = 1, 16 do
		local a = i * 0.85
		r:add({ sz = V(0.22, 0.16, 0.16), p = V(math.sin(a) * 1.03, 1.75 + i * 0.1, math.cos(a) * 0.82), c = GOLD, m = NEON })
	end

	-- arms with leaf gloves
	r:sym({ sz = V(0.6, 1.2, 0.6), p = V(-1.3, 2.75, 0), r = V(0, 0, -10), c = LEAF2, j = "ArmL" })
	r:sym({ sz = V(0.5, 0.6, 0.3), p = V(-1.35, 3.1, -0.25), r = V(0, 0, -10), c = LEAF, j = "ArmL" })
	r:sym({ sz = V(0.72, 0.68, 0.72), p = V(-1.42, 2.05, 0), c = LEAF, j = "ArmL" })
	r:sym({ sz = V(0.28, 0.4, 0.28), p = V(-1.2, 2.15, -0.3), r = V(0, 0, 20), c = LEAF, j = "ArmL" })

	-- face
	r:add({ sz = V(2.3, 2.1, 1.9), p = V(0, 4.75, 0), c = FACE, j = "Head" })
	r:sym({ sz = V(0.45, 0.25, 0.1), p = V(-0.78, 4.42, -0.86), c = C(255, 140, 150), j = "Head" })
	r:eye(V(-0.45, 4.95, -0.82), 0.64, C(120, 65, 20), "Head")
	r:eye(V(0.45, 4.95, -0.82), 0.64, C(120, 65, 20), "Head")
	r:sym({ sz = V(0.46, 0.12, 0.12), p = V(-0.45, 5.48, -0.8), r = V(0, 0, -12), c = C(110, 60, 25), j = "Head" })
	r:add({ sz = V(0.78, 0.58, 0.22), p = V(0, 4.3, -0.9), c = C(130, 20, 30), j = "Head" })
	r:add({ sz = V(0.46, 0.25, 0.15), p = V(0, 4.15, -0.97), c = C(255, 110, 130), j = "Head" })
	r:add({ s = "box", sz = V(0.34, 0.1, 0.05), p = V(0, 4.53, -0.99), c = WHITE, j = "Head" })

	-- big pink petals (two layers)
	r:ring(10, function(i, a)
		return { sz = V(1.2, 1.95, 0.45), p = V(math.sin(a) * 1.55, 4.75 + math.cos(a) * 1.45, 0.4), r = V(0, 0, -math.deg(a)), c = PINK, j = "Head" }
	end)
	r:ring(10, function(i, a)
		return { sz = V(0.65, 1.0, 0.3), p = V(math.sin(a) * 1.85, 4.75 + math.cos(a) * 1.75, 0.22), r = V(0, 0, -math.deg(a)), c = PINK_LIGHT, j = "Head" }
	end)
	r:ring(10, function(i, a)
		a += math.pi / 10
		return { sz = V(1.1, 1.8, 0.4), p = V(math.sin(a) * 1.45, 4.75 + math.cos(a) * 1.35, 0.7), r = V(0, 0, -math.deg(a)), c = PINK_DARK, j = "Head" }
	end)
	r:add({ sz = V(0.9, 0.6, 0.5), p = V(0, 4.75, 0.95), c = LEAF, j = "Head" })

	-- flower crown
	for i = -3, 3 do
		local p = V(i * 0.32, 5.72 - math.abs(i) * 0.09, -0.4 + math.abs(i) * 0.05)
		r:add({ sz = V(0.36, 0.18, 0.3), p = p + V(0.15, -0.05, 0.1), c = LEAF2, j = "Head" })
		r:add({ s = "ball", sz = V(0.4, 0, 0), p = p, c = WHITE, j = "Head" })
		r:add({ s = "ball", sz = V(0.17, 0, 0), p = p + V(0, 0.02, -0.16), c = C(255, 210, 50), j = "Head" })
	end

	-- golden sparkle ring around the body (spins in the Gait module)
	r:ring(18, function(i, a)
		return { s = "ball", sz = V(0.18, 0, 0), p = V(math.cos(a) * 1.55, 2.6 + math.sin(a * 2) * 0.15, math.sin(a) * 1.55), c = GOLD, m = NEON, j = "Halo" }
	end)

	r:emitter("Body", { Rate = 4, Lifetime = NumberRange.new(1, 1.6), Speed = NumberRange.new(0.5, 1.2), SpreadAngle = Vector2.new(180, 180), Size = NumberSequence.new(0.25, 0), Color = ColorSequence.new(PINK_LIGHT, GOLD) })
	r:light("Head", C(255, 200, 120), 0.6, 8)
	return r:finish("GrassAndFlowers", "cute")
end
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">LavaStone</string><ProtectedString name="Source"><![CDATA[-- Lava Stone (Super Rare): a little volcano king. Dark cracked rock body with glowing
-- lava cracks, lava dripping from the crater, a big smoke cloud on top, golden crown
-- with red gems, angry glowing eyes and a gold-tooth grin, white fur collar,
-- royal red cape with a flame emblem, gold chain, and red-gold sneakers.
local Rig = require(script.Parent.Parent.Rig)
local C, V = Color3.fromRGB, Vector3.new

local ROCK = C(48, 40, 42)
local ROCK2 = C(68, 56, 54)
local LAVA = C(255, 120, 20)
local LAVA2 = C(255, 190, 40)
local GOLD = C(240, 185, 45)
local RED = C(150, 18, 24)
local WHITE = C(250, 250, 245)
local NEON = Enum.Material.Neon
local METAL = Enum.Material.Metal
local BASALT = Enum.Material.Basalt

return function(): Model
	local r = Rig.new("LavaStone", 2.0)
	r:symJoint("LegL", V(-0.6, 1.6, 0))
	r:symJoint("ArmL", V(-1.25, 3.05, 0))
	r:joint("Head", V(0, 5.1, 0))
	r:joint("Cape", V(0, 3.05, 0.9))

	-- sneakers
	r:sym({ sz = V(1.02, 0.75, 1.45), p = V(-0.6, 0.42, -0.15), c = C(200, 30, 35), j = "LegL" })
	r:sym({ sz = V(1.08, 0.26, 1.52), p = V(-0.6, 0.14, -0.15), c = WHITE, j = "LegL" })
	r:sym({ sz = V(0.82, 0.42, 0.6), p = V(-0.6, 0.38, -0.72), c = WHITE, j = "LegL" })
	r:sym({ sz = V(0.2, 0.28, 0.9), p = V(-1.08, 0.45, -0.12), c = GOLD, m = METAL, j = "LegL" })
	r:sym({ s = "box", sz = V(0.5, 0.06, 0.08), p = V(-0.6, 0.78, -0.42), c = LAVA2, m = NEON, j = "LegL" })
	r:sym({ s = "box", sz = V(0.5, 0.06, 0.08), p = V(-0.6, 0.78, -0.22), c = LAVA2, m = NEON, j = "LegL" })
	r:sym({ sz = V(0.72, 0.95, 0.72), p = V(-0.6, 1.1, 0), c = ROCK, m = BASALT, j = "LegL" })

	-- the volcano body: stacked rock rings getting smaller
	local rings = { { 2.7, 0.8, 1.9 }, { 2.45, 0.75, 2.6 }, { 2.2, 0.75, 3.3 }, { 1.9, 0.7, 3.95 }, { 1.6, 0.6, 4.55 }, { 1.38, 0.45, 5.05 } }
	for k, ring in rings do
		r:add({ s = "cyl", sz = V(ring[1], ring[2], ring[1]), p = V(0, ring[3], 0), c = (k % 2 == 0) and ROCK2 or ROCK, m = BASALT })
	end
	-- glowing lava cracks all around
	local rng = Random.new(7)
	for i = 1, 22 do
		local a = rng:NextNumber(0, math.pi * 2)
		local y = rng:NextNumber(1.8, 5.0)
		local rad = 1.38 - (y - 1.8) * 0.2
		r:add({ s = "box", sz = V(0.07, rng:NextNumber(0.4, 0.9), 0.05), p = V(math.sin(a) * rad, y, math.cos(a) * rad), r = V(0, math.deg(a), rng:NextNumber(-35, 35)), c = (i % 3 == 0) and LAVA2 or LAVA, m = NEON })
	end
	-- crater with lava and drips
	r:add({ s = "cyl", sz = V(1.2, 0.16, 1.2), p = V(0, 5.3, 0), c = LAVA, m = NEON, j = "Head" })
	for i = 1, 8 do
		local a = (i / 8) * math.pi * 2
		r:add({ sz = V(0.24, 0.55 + (i % 3) * 0.2, 0.2), p = V(math.sin(a) * 0.68, 5.0 - (i % 3) * 0.1, math.cos(a) * 0.68), c = (i % 2 == 0) and LAVA2 or LAVA, m = NEON, j = "Head" })
	end
	-- smoke cloud
	r:add({ sz = V(0.9, 1.0, 0.9), p = V(0, 5.8, 0), c = C(85, 70, 68), j = "Head" })
	r:add({ sz = V(2.7, 1.4, 2.5), p = V(0, 6.65, 0), c = C(70, 60, 60), j = "Head" })
	r:sym({ sz = V(1.6, 1.25, 1.6), p = V(-1.0, 6.95, 0.2), c = C(62, 52, 54), j = "Head" })
	r:add({ sz = V(1.5, 1.2, 1.5), p = V(0, 7.35, -0.3), c = C(80, 68, 66), j = "Head" })
	r:add({ sz = V(1.3, 1.1, 1.3), p = V(0.2, 7.5, 0.5), c = C(58, 50, 52), j = "Head" })
	r:add({ sz = V(2.3, 0.35, 2.1), p = V(0, 6.05, 0), c = LAVA, m = NEON, t = 0.35, j = "Head" })
	-- golden crown
	r:add({ s = "cyl", sz = V(1.62, 0.36, 1.62), p = V(0, 5.32, 0), c = GOLD, m = METAL, refl = 0.15, j = "Head" })
	r:ring(7, function(i, a)
		return { sz = V(0.24, 0.62, 0.24), p = V(math.sin(a) * 0.78, 5.72, math.cos(a) * 0.78), c = GOLD, m = METAL, j = "Head" }
	end)
	r:add({ s = "box", sz = V(0.3, 0.3, 0.1), p = V(0, 5.35, -0.82), r = V(0, 0, 45), c = C(255, 30, 40), m = NEON, j = "Head" })
	r:sym({ s = "ball", sz = V(0.15, 0, 0), p = V(-0.5, 5.33, -0.62), c = C(255, 30, 40), m = NEON, j = "Head" })

	-- angry face
	r:sym({ sz = V(0.58, 0.44, 0.2), p = V(-0.45, 3.85, -1.0), r = V(0, 0, -15), c = LAVA2, m = NEON })
	r:sym({ sz = V(0.24, 0.24, 0.1), p = V(-0.4, 3.82, -1.09), c = C(30, 10, 5) })
	r:sym({ s = "box", sz = V(0.75, 0.2, 0.18), p = V(-0.45, 4.18, -1.0), r = V(0, 0, -22), c = C(15, 12, 12) })
	r:add({ sz = V(1.25, 0.52, 0.2), p = V(0, 3.22, -1.1), c = C(25, 10, 8) })
	r:add({ s = "box", sz = V(1.0, 0.18, 0.08), p = V(0, 3.32, -1.18), c = LAVA2, m = NEON })
	for k = -2, 2 do
		r:add({ s = "box", sz = V(0.02, 0.18, 0.09), p = V(k * 0.2, 3.32, -1.19), c = C(160, 110, 20) })
	end

	-- white fur collar with black dots
	r:ring(13, function(i, a)
		return { sz = V(0.75, 0.6, 0.65), p = V(math.sin(a) * 1.22, 2.95, math.cos(a) * 1.22), c = WHITE }
	end)
	for i = 1, 6 do
		local a = i * 1.05
		r:add({ s = "ball", sz = V(0.1, 0, 0), p = V(math.sin(a) * 1.5, 3.0, math.cos(a) * 1.5), c = C(10, 10, 10) })
	end
	-- gold chain with a red gem
	for i = -5, 5 do
		local x = i * 0.17
		r:add({ s = "ball", sz = V(0.15, 0, 0), p = V(x, 2.62 + (x * x) * 0.5, -1.3 + math.abs(x) * 0.12), c = GOLD, m = METAL })
	end
	r:add({ sz = V(0.55, 0.65, 0.18), p = V(0, 2.3, -1.34), c = GOLD, m = METAL })
	r:add({ s = "box", sz = V(0.34, 0.34, 0.12), p = V(0, 2.3, -1.42), r = V(0, 0, 45), c = C(255, 30, 40), m = NEON })

	-- royal cape
	r:add({ s = "box", sz = V(2.75, 2.6, 0.15), p = V(0, 1.8, 1.28), r = V(10, 0, 0), c = RED, j = "Cape" })
	r:add({ s = "box", sz = V(2.8, 0.2, 0.2), p = V(0, 0.56, 1.48), r = V(10, 0, 0), c = GOLD, m = METAL, j = "Cape" })
	r:sym({ s = "box", sz = V(0.15, 2.5, 0.2), p = V(-1.33, 1.8, 1.3), r = V(10, 0, 0), c = GOLD, m = METAL, j = "Cape" })
	r:add({ sz = V(0.7, 1.0, 0.1), p = V(0, 1.9, 1.42), r = V(10, 0, 0), c = LAVA, m = NEON, j = "Cape" })
	r:add({ sz = V(0.34, 0.55, 0.1), p = V(0, 1.75, 1.47), r = V(10, 0, 0), c = LAVA2, m = NEON, j = "Cape" })

	-- rocky arms with gold bracelets
	r:sym({ sz = V(0.78, 1.3, 0.78), p = V(-1.45, 2.45, 0), r = V(0, 0, -12), c = ROCK, m = BASALT, j = "ArmL" })
	r:sym({ s = "cyl", sz = V(0.9, 0.26, 0.9), p = V(-1.52, 2.0, 0), c = GOLD, m = METAL, j = "ArmL" })
	r:sym({ sz = V(0.9, 0.82, 0.9), p = V(-1.56, 1.6, 0), c = ROCK2, m = BASALT, j = "ArmL" })
	r:sym({ s = "box", sz = V(0.05, 0.4, 0.05), p = V(-1.4, 2.5, -0.4), r = V(0, 0, 25), c = LAVA, m = NEON, j = "ArmL" })

	r:emitter("Head", { Name = "WalkSmoke", Rate = 0, Texture = Rig.TEX.smoke, LightEmission = 0, Lifetime = NumberRange.new(2, 2), Speed = NumberRange.new(1.5, 3), SpreadAngle = Vector2.new(35, 35), Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 3.5) }), Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) }), Color = ColorSequence.new(C(90, 80, 80)), EmissionDirection = Enum.NormalId.Top })
	r:emitter("Head", { Rate = 3, Texture = Rig.TEX.fire, Lifetime = NumberRange.new(0.6, 1), Speed = NumberRange.new(1, 2), Size = NumberSequence.new(0.4, 0), Color = ColorSequence.new(LAVA2, LAVA), EmissionDirection = Enum.NormalId.Top })
	r:light("Body", LAVA, 1.2, 10)
	return r:finish("LavaStone", "bully")
end
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">MagicTree</string><ProtectedString name="Source"><![CDATA[-- Magic Tree (Rare): blocky bark body with glowing orange cracks, green vines with white
-- flowers, pink mushroom friends at the feet, purple crystals on the shoulders,
-- a glowing target on the chest, star eyes, leafy crown with horns, golden crystal
-- earrings, pixel sunglasses and a little yellow sprout sitting on top.
local Rig = require(script.Parent.Parent.Rig)
local C, V = Color3.fromRGB, Vector3.new

local BARK = C(130, 78, 40)
local BARK_D = C(95, 55, 28)
local BARK_L = C(160, 100, 58)
local CRACK = C(255, 165, 50)
local VINE = C(110, 180, 50)
local LEAF = C(115, 185, 55)
local LEAF2 = C(140, 205, 70)
local LEAF3 = C(85, 155, 45)
local WHITE = C(255, 255, 255)
local NEON = Enum.Material.Neon
local WOOD = Enum.Material.Wood

local function flower(r, p: Vector3, j: string?)
	r:add({ s = "ball", sz = V(0.36, 0, 0), p = p, c = WHITE, j = j })
	r:add({ s = "ball", sz = V(0.15, 0, 0), p = p + V(0, 0, -0.15), c = C(255, 200, 60), j = j })
end

local function mushroom(r, p: Vector3, j: string)
	r:add({ sz = V(0.38, 0.45, 0.38), p = p, c = C(250, 225, 170), j = j })
	r:add({ sz = V(0.9, 0.48, 0.9), p = p + V(0, 0.32, 0), c = C(240, 115, 205), j = j })
	for _, d in { V(0, 0.55, 0), V(0.22, 0.45, -0.25), V(-0.25, 0.45, -0.18), V(0.28, 0.42, 0.2) } do
		r:add({ s = "ball", sz = V(0.13, 0, 0), p = p + d, c = WHITE, j = j })
	end
	r:add({ s = "ball", sz = V(0.07, 0, 0), p = p + V(-0.08, 0.02, -0.19), c = C(20, 20, 20), j = j })
	r:add({ s = "ball", sz = V(0.07, 0, 0), p = p + V(0.08, 0.02, -0.19), c = C(20, 20, 20), j = j })
end

return function(): Model
	local r = Rig.new("MagicTree", 2.2)
	r:symJoint("LegL", V(-0.65, 1.9, 0))
	r:symJoint("ArmL", V(-1.35, 3.75, 0))
	r:joint("Head", V(0, 4.0, 0))

	-- legs like tree trunks with roots
	r:sym({ s = "box", sz = V(1.0, 1.6, 1.0), p = V(-0.65, 1.15, 0), c = BARK, m = WOOD, j = "LegL" })
	r:sym({ sz = V(1.35, 0.62, 1.55), p = V(-0.65, 0.3, -0.12), c = BARK_D, m = WOOD, j = "LegL" })
	for k = -1, 1 do
		r:sym({ sz = V(0.32, 0.3, 0.55), p = V(-0.65 + k * 0.38, 0.17, -0.85), c = BARK, j = "LegL" })
	end
	r:sym({ s = "box", sz = V(0.07, 1.0, 0.05), p = V(-0.5, 1.15, -0.52), r = V(0, 0, 9), c = CRACK, m = NEON, j = "LegL" })
	r:sym({ s = "box", sz = V(0.06, 0.6, 0.05), p = V(-0.85, 1.4, -0.52), r = V(0, 0, -14), c = CRACK, m = NEON, j = "LegL" })
	for k, y in { 0.75, 1.25, 1.7 } do
		r:sym({ sz = V(1.15, 0.2, 1.15), p = V(-0.65, y, 0), r = V(0, k * 40, (k % 2 == 0) and 12 or -12), c = VINE, j = "LegL" })
	end
	flower(r, V(-0.95, 1.3, -0.55), "LegL")
	flower(r, V(0.4, 0.95, -0.55), "LegR")
	mushroom(r, V(-1.35, 0.23, -0.55), "LegL")
	mushroom(r, V(1.35, 0.23, -0.55), "LegR")

	-- trunk body
	r:add({ s = "box", sz = V(2.3, 2.2, 1.5), p = V(0, 2.95, 0), c = BARK, m = WOOD })
	r:add({ s = "box", sz = V(2.2, 0.5, 1.45), p = V(0, 3.95, 0), c = BARK_L, m = WOOD })
	for _, d in { { -0.7, 2.6, 6 }, { 0.75, 2.4, -8 }, { 0.5, 3.4, 15 }, { -0.4, 3.55, -12 } } do
		r:add({ s = "box", sz = V(0.07, 0.75, 0.05), p = V(d[1], d[2], -0.76), r = V(0, 0, d[3]), c = CRACK, m = NEON })
	end
	-- glowing target on the chest, heart on the back
	r:add({ s = "cyl", sz = V(0.95, 0.06, 0.95), p = V(0, 3.15, -0.77), r = V(90, 0, 0), c = CRACK, m = NEON })
	r:add({ s = "cyl", sz = V(0.65, 0.07, 0.65), p = V(0, 3.15, -0.79), r = V(90, 0, 0), c = BARK_D })
	r:add({ s = "cyl", sz = V(0.38, 0.08, 0.38), p = V(0, 3.15, -0.81), r = V(90, 0, 0), c = CRACK, m = NEON })
	r:add({ s = "ball", sz = V(0.16, 0, 0), p = V(0, 3.15, -0.84), c = BARK_D })
	r:sym({ sz = V(0.38, 0.32, 0.08), p = V(-0.15, 3.1, 0.77), r = V(0, 0, 35), c = CRACK, m = NEON })
	-- leaf skirt
	r:ring(12, function(i, a)
		return { sz = V(0.85, 1.0, 0.3), p = V(math.sin(a) * 1.25, 2.0, math.cos(a) * 0.85), r = V(-32, math.deg(a), 0), c = (i % 2 == 0) and LEAF or LEAF3 }
	end)
	-- vines across the chest with flowers
	r:add({ sz = V(2.5, 0.22, 0.3), p = V(0, 3.55, -0.75), r = V(0, 0, 22), c = VINE })
	r:add({ sz = V(2.5, 0.22, 0.3), p = V(0, 2.55, -0.75), r = V(0, 0, -18), c = VINE })
	flower(r, V(-0.85, 3.2, -0.82))
	flower(r, V(0.9, 3.85, -0.8))
	flower(r, V(0.6, 2.45, -0.85))
	-- purple crystals on the shoulders
	for k, d in { V(0, 0, 0), V(0.3, -0.1, 0.25), V(-0.25, -0.1, -0.2) } do
		r:sym({ s = "box", sz = V(0.3, 0.75 - k * 0.1, 0.3), p = V(-1.25, 4.3, 0) + d, r = V(15 * k, 45, 20 - k * 12), c = C(200, 130, 255), m = (k == 1) and NEON or Enum.Material.Glass, t = (k == 1) and 0.1 or 0.15 })
	end

	-- arms
	r:sym({ s = "box", sz = V(0.9, 1.7, 0.9), p = V(-1.55, 2.95, 0), c = BARK, m = WOOD, j = "ArmL" })
	r:sym({ s = "box", sz = V(1.0, 0.8, 1.0), p = V(-1.6, 1.85, 0), c = BARK_D, m = WOOD, j = "ArmL" })
	r:sym({ sz = V(1.05, 0.2, 1.05), p = V(-1.55, 3.3, 0), r = V(0, 30, 14), c = VINE, j = "ArmL" })
	r:sym({ s = "box", sz = V(0.06, 0.7, 0.05), p = V(-1.4, 2.7, -0.47), r = V(0, 0, 10), c = CRACK, m = NEON, j = "ArmL" })

	-- face
	r:add({ sz = V(2.25, 1.95, 1.8), p = V(0, 4.95, 0), c = BARK_L, j = "Head" })
	r:eye(V(-0.5, 5.0, -0.8), 0.72, C(255, 170, 30), "Head", { glow = true })
	r:eye(V(0.5, 5.0, -0.8), 0.72, C(255, 170, 30), "Head", { glow = true })
	r:sym({ s = "box", sz = V(0.12, 0.42, 0.04), p = V(-0.5, 4.97, -1.06), r = V(0, 0, 45), c = C(255, 245, 160), m = NEON, j = "Head" })
	r:sym({ s = "box", sz = V(0.12, 0.42, 0.04), p = V(-0.5, 4.97, -1.06), r = V(0, 0, -45), c = C(255, 245, 160), m = NEON, j = "Head" })
	r:sym({ sz = V(0.4, 0.22, 0.08), p = V(-0.82, 4.55, -0.82), c = C(240, 120, 140), j = "Head" })
	r:add({ sz = V(0.5, 0.22, 0.1), p = V(0, 4.45, -0.88), c = C(60, 25, 15), j = "Head" })
	r:add({ sz = V(0.26, 0.32, 0.1), p = V(0, 4.3, -0.9), c = C(255, 110, 140), j = "Head" })

	-- leafy crown
	r:ring(11, function(i, a)
		return { sz = V(1.05, 0.72, 0.85), p = V(math.sin(a) * 1.25, 5.75 + (i % 2) * 0.12, math.cos(a) * 1.1), r = V(-20, math.deg(a), 0), c = (i % 3 == 0) and LEAF3 or LEAF, j = "Head" }
	end)
	r:ring(8, function(i, a)
		return { sz = V(1.0, 0.7, 0.85), p = V(math.sin(a + 0.4) * 0.75, 6.2, math.cos(a + 0.4) * 0.65), r = V(-12, math.deg(a), 0), c = (i % 2 == 0) and LEAF2 or LEAF, j = "Head" }
	end)
	r:add({ sz = V(1.4, 0.8, 1.3), p = V(0, 6.5, 0), c = LEAF2, j = "Head" })
	for k = -2, 2 do
		r:add({ sz = V(0.7, 0.55, 0.4), p = V(k * 0.42, 5.55 - math.abs(k) * 0.05, -0.95), r = V(25, 0, k * 8), c = (k % 2 == 0) and LEAF or LEAF2, j = "Head" })
	end
	flower(r, V(-0.95, 6.0, -0.75), "Head")
	flower(r, V(0.65, 6.35, -0.55), "Head")
	flower(r, V(1.3, 5.75, 0.2), "Head")
	flower(r, V(-0.3, 6.6, 0.6), "Head")
	-- horns
	r:sym({ sz = V(0.38, 0.95, 0.38), p = V(-1.3, 5.75, 0.1), r = V(0, 0, 35), c = BARK_D, j = "Head" })
	r:sym({ sz = V(0.3, 0.8, 0.3), p = V(-1.62, 6.35, 0.1), r = V(0, 0, -12), c = BARK_D, j = "Head" })
	-- golden crystal earrings
	r:sym({ s = "box", sz = V(0.05, 0.4, 0.05), p = V(-1.18, 4.95, -0.15), c = C(200, 150, 40), j = "Head" })
	r:sym({ s = "box", sz = V(0.34, 0.34, 0.34), p = V(-1.18, 4.55, -0.15), r = V(45, 0, 45), c = C(255, 205, 50), m = NEON, j = "Head" })
	-- pixel sunglasses resting on the leaves
	r:add({ s = "box", sz = V(0.95, 0.3, 0.1), p = V(0.6, 5.95, -0.95), r = V(0, 0, -10), c = C(15, 15, 15), j = "Head" })
	r:add({ s = "box", sz = V(0.2, 0.1, 0.02), p = V(0.42, 6.0, -1.01), r = V(0, 0, -10), c = WHITE, j = "Head" })
	-- little sprout friend on top
	r:add({ sz = V(1.05, 0.72, 0.92), p = V(0, 7.05, 0), c = C(250, 222, 125), j = "Head" })
	r:add({ s = "ball", sz = V(0.1, 0, 0), p = V(-0.18, 7.1, -0.44), c = C(30, 20, 10), j = "Head" })
	r:add({ s = "ball", sz = V(0.1, 0, 0), p = V(0.18, 7.1, -0.44), c = C(30, 20, 10), j = "Head" })
	r:add({ sz = V(0.18, 0.08, 0.05), p = V(0, 6.95, -0.45), c = C(220, 90, 90), j = "Head" })
	r:add({ s = "box", sz = V(0.06, 0.3, 0.06), p = V(0, 7.5, 0), c = LEAF3, j = "Head" })
	r:sym({ sz = V(0.34, 0.12, 0.2), p = V(-0.16, 7.65, 0), r = V(0, 0, 28), c = LEAF2, j = "Head" })
	-- green bow with a star on the back of the head
	r:sym({ sz = V(0.75, 0.55, 0.3), p = V(-0.42, 5.0, 0.95), r = V(0, 0, 15), c = LEAF2, j = "Head" })
	r:add({ s = "box", sz = V(0.32, 0.32, 0.1), p = V(0, 5.0, 1.08), r = V(0, 0, 45), c = C(255, 220, 70), m = NEON, j = "Head" })

	r:light("Body", CRACK, 0.8, 8)
	return r:finish("MagicTree", "cute")
end
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">SolarioLeonario</string><ProtectedString name="Source"><![CDATA[-- Solario Leonario (Secret): a blocky sandstone sun lion. Huge glowing golden crystal
-- mane, glowing eyes, metal headband with a big blue gem, sun emblems on its sides,
-- gold bands with blue gems on its legs, and a tail ending in a crystal flame.
local Rig = require(script.Parent.Parent.Rig)
local C, V = Color3.fromRGB, Vector3.new

local SAND = C(238, 208, 140)
local SAND2 = C(220, 185, 118)
local SAND3 = C(250, 225, 170)
local MANE = C(255, 170, 20)
local MANE2 = C(255, 215, 60)
local MANE3 = C(255, 135, 10)
local GOLD = C(240, 185, 40)
local GEM = C(60, 175, 255)
local NEON = Enum.Material.Neon
local GLASS = Enum.Material.Glass
local METAL = Enum.Material.Metal
local SAND_M = Enum.Material.Sandstone

local function gem(r, p: Vector3, j: string?, size: number?)
	local s = size or 0.3
	r:add({ s = "box", sz = V(s + 0.12, s + 0.12, 0.1), p = p, r = V(0, 0, 45), c = GOLD, m = METAL, j = j })
	r:add({ s = "box", sz = V(s, s, 0.12), p = p + V(0, 0, -0.03), r = V(0, 0, 45), c = GEM, m = NEON, j = j })
end

return function(): Model
	local r = Rig.new("SolarioLeonario", 2.6)
	r:symJoint("LegFL", V(-0.75, 2.45, -1.3))
	r:symJoint("LegBL", V(-0.75, 2.45, 1.6))
	r:joint("Head", V(0, 3.6, -1.9))
	r:joint("Mane", V(0, 4.0, -2.2), "Head")
	r:joint("Tail", V(0, 3.5, 2.25))

	-- blocky body with stone seams
	r:add({ s = "box", sz = V(2.2, 1.9, 4.0), p = V(0, 3.05, 0.2), c = SAND, m = SAND_M })
	for k = 0, 4 do
		r:sym({ s = "box", sz = V(0.05, 1.8, 0.05), p = V(-1.11, 3.05, -1.4 + k * 0.8), c = SAND2 })
	end
	r:sym({ s = "box", sz = V(0.05, 0.05, 3.9), p = V(-1.11, 3.4, 0.2), c = SAND2 })
	r:add({ s = "box", sz = V(1.9, 0.3, 3.7), p = V(0, 4.05, 0.2), c = SAND3, m = SAND_M })
	-- sun emblems on both sides
	r:sym({ s = "cyl", sz = V(1.0, 0.08, 1.0), p = V(-1.13, 3.05, 0.6), r = V(0, 0, 90), c = MANE2, m = NEON })
	for i = 1, 8 do
		local a = i / 8 * math.pi * 2
		r:sym({ s = "box", sz = V(0.06, 0.32, 0.12), p = V(-1.14, 3.05 + math.cos(a) * 0.68, 0.6 + math.sin(a) * 0.68), r = V(math.deg(a), 0, 0), c = MANE, m = NEON })
	end
	gem(r, V(-1.16, 3.6, -0.9))
	gem(r, V(1.16, 3.6, -0.9))

	-- four legs with paws, gold bands and blue gems
	for _, j in { "LegFL", "LegBL" } do
		local z = (j == "LegFL") and -1.3 or 1.6
		r:sym({ s = "box", sz = V(0.82, 1.7, 0.85), p = V(-0.75, 1.55, z), c = SAND, m = SAND_M, j = j })
		r:sym({ s = "box", sz = V(1.05, 0.55, 1.2), p = V(-0.75, 0.28, z - 0.15), c = SAND3, m = SAND_M, j = j })
		for k = -1, 1 do
			r:sym({ s = "box", sz = V(0.26, 0.3, 0.25), p = V(-0.75 + k * 0.32, 0.2, z - 0.82), c = SAND2, j = j })
		end
		r:sym({ s = "box", sz = V(0.92, 0.26, 0.95), p = V(-0.75, 1.0, z), c = GOLD, m = METAL, j = j })
		r:sym({ s = "box", sz = V(0.22, 0.22, 0.1), p = V(-0.75, 1.0, z - 0.5), r = V(0, 0, 45), c = GEM, m = NEON, j = j })
	end

	-- blocky head
	r:add({ s = "box", sz = V(1.6, 1.5, 1.4), p = V(0, 4.0, -2.45), c = SAND, m = SAND_M, j = "Head" })
	r:add({ s = "box", sz = V(0.95, 0.62, 0.62), p = V(0, 3.6, -3.15), c = SAND3, m = SAND_M, j = "Head" })
	r:add({ s = "box", sz = V(0.42, 0.24, 0.2), p = V(0, 3.86, -3.46), c = C(30, 20, 15), j = "Head" })
	r:add({ s = "box", sz = V(0.06, 0.25, 0.04), p = V(0, 3.62, -3.47), c = C(60, 40, 25), j = "Head" })
	r:add({ s = "box", sz = V(0.6, 0.05, 0.04), p = V(0, 3.48, -3.47), c = C(60, 40, 25), j = "Head" })
	r:sym({ s = "box", sz = V(0.42, 0.22, 0.1), p = V(-0.4, 4.25, -3.16), c = C(255, 230, 90), m = NEON, j = "Head" })
	r:sym({ s = "box", sz = V(0.45, 0.1, 0.12), p = V(-0.4, 4.42, -3.17), r = V(0, 0, -12), c = SAND2, j = "Head" })
	-- headband with a big blue gem
	r:add({ s = "box", sz = V(1.7, 0.3, 1.5), p = V(0, 4.6, -2.45), c = C(110, 105, 110), m = METAL, j = "Head" })
	gem(r, V(0, 4.62, -3.22), "Head", 0.38)

	-- huge crystal mane (spins slightly in the wind through the Gait module)
	local function shard(i: number, a: number, rad: number, z: number, len: number)
		local cols = { MANE, MANE2, MANE3 }
		return { s = "box", sz = V(0.5, len, 0.4), p = V(math.sin(a) * rad, 4.0 + math.cos(a) * rad, z), r = V(0, 0, -math.deg(a)), c = cols[(i % 3) + 1], m = (i % 2 == 0) and NEON or GLASS, t = (i % 2 == 0) and 0 or 0.05, j = "Mane" }
	end
	r:ring(16, function(i, a)
		return shard(i, a, 1.2, -2.0, 1.6)
	end)
	r:ring(13, function(i, a)
		return shard(i + 1, a + 0.2, 1.05, -1.55, 1.9)
	end)
	r:ring(10, function(i, a)
		return shard(i + 2, a + 0.1, 0.85, -1.15, 1.5)
	end)
	for k = -2, 2 do
		r:add({ s = "box", sz = V(0.4, 1.1, 0.35), p = V(k * 0.32, 2.75, -2.35), r = V(-10, 0, k * 10), c = (k % 2 == 0) and MANE2 or MANE, m = NEON, j = "Mane" })
	end

	-- tail with a crystal flame
	r:add({ s = "box", sz = V(0.36, 0.36, 0.95), p = V(0, 3.75, 2.75), r = V(-35, 0, 0), c = SAND, j = "Tail" })
	r:add({ s = "box", sz = V(0.34, 0.34, 0.9), p = V(0, 4.3, 3.15), r = V(-65, 0, 0), c = SAND, j = "Tail" })
	r:add({ s = "box", sz = V(0.5, 0.25, 0.5), p = V(0, 4.75, 3.32), c = GOLD, m = METAL, j = "Tail" })
	for k = 0, 4 do
		local a = k / 5 * math.pi * 2
		r:add({ s = "box", sz = V(0.28, 0.85, 0.28), p = V(math.sin(a) * 0.18, 5.15, 3.35 + math.cos(a) * 0.18), r = V(math.cos(a) * 20, 45, math.sin(a) * 20), c = (k % 2 == 0) and MANE2 or MANE, m = NEON, j = "Tail" })
	end
	r:add({ s = "box", sz = V(0.2, 0.2, 0.2), p = V(0, 4.78, 3.06), r = V(45, 0, 45), c = GEM, m = NEON, j = "Tail" })

	r:emitter("Mane", { Rate = 10, Lifetime = NumberRange.new(0.8, 1.5), Speed = NumberRange.new(1, 2.5), SpreadAngle = Vector2.new(180, 180), Size = NumberSequence.new(0.35, 0), Color = ColorSequence.new(MANE2, C(255, 255, 200)) })
	r:light("Mane", C(255, 200, 80), 2.5, 16)
	return r:finish("SolarioLeonario", "quad", 1.0)
end
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">WitchinaMagichina</string><ProtectedString name="Source"><![CDATA[-- Witchina Magichina (Mythic): a chibi witch. Long lavender hair, a huge purple witch hat
-- with a ruffled brim, a big bow, hanging gold stars and a crooked tip, glowing purple
-- eyes and a fang smile, purple frilly dress with gold stars, a belt full of glowing
-- potions, striped stockings, black boots with bows, a staff with a purple crystal,
-- and a glowing potion always in her hand.
local Rig = require(script.Parent.Parent.Rig)
local C, V = Color3.fromRGB, Vector3.new

local PURPLE = C(105, 45, 160)
local PURPLE_D = C(58, 24, 92)
local LILAC = C(195, 145, 235)
local FRILL = C(238, 220, 252)
local HAIR = C(212, 172, 238)
local HAIR2 = C(190, 150, 225)
local SKIN = C(252, 218, 192)
local GOLD = C(245, 195, 70)
local POTION = C(200, 80, 255)
local NEON = Enum.Material.Neon
local GLASS = Enum.Material.Glass
local METAL = Enum.Material.Metal

local function star(r, p: Vector3, s: number, j: string?)
	r:add({ s = "box", sz = V(s, s, 0.06), p = p, c = GOLD, m = NEON, j = j })
	r:add({ s = "box", sz = V(s, s, 0.06), p = p, r = V(0, 0, 45), c = GOLD, m = NEON, j = j })
end

local function bottle(r, p: Vector3, s: number, j: string?)
	r:add({ sz = V(0.4 * s, 0.5 * s, 0.4 * s), p = p, c = POTION, m = NEON, j = j })
	r:add({ sz = V(0.52 * s, 0.64 * s, 0.52 * s), p = p, c = C(230, 210, 255), m = GLASS, t = 0.55, j = j })
	r:add({ s = "cyl", sz = V(0.18 * s, 0.28 * s, 0.18 * s), p = p + V(0, 0.4 * s, 0), c = C(230, 210, 255), m = GLASS, t = 0.4, j = j })
	r:add({ s = "cyl", sz = V(0.2 * s, 0.14 * s, 0.2 * s), p = p + V(0, 0.58 * s, 0), c = C(140, 90, 50), j = j })
end

return function(): Model
	local r = Rig.new("WitchinaMagichina", 2.0)
	r:symJoint("LegL", V(-0.45, 1.8, 0))
	r:symJoint("ArmL", V(-1.0, 3.8, 0))
	r:joint("Head", V(0, 3.9, 0))

	-- boots with bows and buckles
	r:sym({ s = "box", sz = V(0.85, 0.75, 1.2), p = V(-0.45, 0.4, -0.1), c = C(35, 25, 42), j = "LegL" })
	r:sym({ s = "box", sz = V(0.9, 0.15, 1.25), p = V(-0.45, 0.08, -0.1), c = C(20, 15, 25), j = "LegL" })
	r:sym({ sz = V(0.3, 0.22, 0.12), p = V(-0.6, 0.72, -0.72), c = LILAC, j = "LegL" })
	r:sym({ sz = V(0.3, 0.22, 0.12), p = V(-0.3, 0.72, -0.72), c = LILAC, j = "LegL" })
	r:sym({ s = "box", sz = V(0.2, 0.2, 0.06), p = V(-0.45, 0.45, -0.72), c = GOLD, m = METAL, j = "LegL" })
	-- striped stockings
	for k = 0, 3 do
		r:sym({ s = "box", sz = V(0.62, 0.22, 0.62), p = V(-0.45, 0.88 + k * 0.22, 0), c = (k % 2 == 0) and PURPLE or LILAC, j = "LegL" })
	end

	-- frilly skirt in layers with gold stars
	r:add({ s = "cyl", sz = V(2.55, 0.55, 2.35), p = V(0, 1.85, 0), c = FRILL })
	r:add({ s = "cyl", sz = V(2.35, 0.7, 2.15), p = V(0, 2.25, 0), c = PURPLE_D })
	r:add({ s = "cyl", sz = V(2.0, 0.45, 1.85), p = V(0, 2.62, 0), c = PURPLE })
	r:ring(10, function(i, a)
		return { s = "box", sz = V(0.18, 0.18, 0.05), p = V(math.sin(a) * 1.17, 2.15, math.cos(a) * 1.07), r = V(0, math.deg(a), 45), c = GOLD, m = NEON }
	end)
	-- bodice with lacing
	r:add({ s = "box", sz = V(1.6, 1.25, 1.05), p = V(0, 3.25, 0), c = PURPLE })
	for k = 0, 3 do
		r:add({ s = "box", sz = V(0.5, 0.05, 0.04), p = V(0, 2.9 + k * 0.22, -0.54), r = V(0, 0, (k % 2 == 0) and 25 or -25), c = LILAC })
	end
	r:sym({ sz = V(0.45, 0.32, 0.18), p = V(-0.25, 3.85, -0.5), r = V(0, 0, 15), c = LILAC })
	star(r, V(0, 3.85, -0.6), 0.18)
	-- belt with glowing potions and a pouch
	r:add({ s = "box", sz = V(1.7, 0.3, 1.12), p = V(0, 2.68, 0), c = C(95, 60, 40) })
	r:add({ s = "box", sz = V(0.3, 0.28, 0.06), p = V(0, 2.68, -0.58), c = GOLD, m = METAL })
	bottle(r, V(-0.92, 2.55, -0.25), 1)
	bottle(r, V(-0.85, 2.55, 0.25), 0.8)
	r:add({ s = "box", sz = V(0.5, 0.55, 0.3), p = V(0.95, 2.5, -0.15), c = C(110, 70, 45) })
	star(r, V(0.95, 2.52, -0.31), 0.16)

	-- arms with puffy sleeves; staff in the left hand, potion in the right
	r:sym({ sz = V(0.82, 0.72, 0.82), p = V(-1.05, 3.65, 0), c = FRILL, j = "ArmL" })
	r:sym({ s = "box", sz = V(0.7, 1.0, 0.7), p = V(-1.1, 3.0, 0), c = PURPLE, j = "ArmL" })
	r:sym({ s = "cyl", sz = V(0.85, 0.22, 0.85), p = V(-1.1, 2.55, 0), c = FRILL, j = "ArmL" })
	r:sym({ s = "box", sz = V(0.55, 0.5, 0.55), p = V(-1.1, 2.25, 0), c = SKIN, j = "ArmL" })
	r:add({ s = "cyl", sz = V(0.18, 4.4, 0.18), p = V(-1.1, 2.3, -0.42), c = C(60, 35, 25), j = "ArmL" })
	r:add({ s = "box", sz = V(0.42, 0.95, 0.42), p = V(-1.1, 4.95, -0.42), r = V(0, 45, 0), c = POTION, m = NEON, j = "ArmL" })
	for k = 0, 5 do
		local a = k * 1.1
		r:add({ s = "ball", sz = V(0.12, 0, 0), p = V(-1.1 + math.cos(a) * 0.3, 4.35 + k * 0.1, -0.42 + math.sin(a) * 0.3), c = GOLD, m = METAL, j = "ArmL" })
	end
	r:add({ sz = V(0.45, 0.2, 0.12), p = V(-1.1, 4.4, -0.62), c = LILAC, j = "ArmL" })
	bottle(r, V(1.12, 1.95, -0.2), 1.2, "ArmR")

	-- head
	r:add({ s = "box", sz = V(1.6, 1.5, 1.4), p = V(0, 4.75, 0), c = SKIN, j = "Head" })
	r:eye(V(-0.38, 4.75, -0.71), 0.46, C(175, 70, 255), "Head", { glow = true, tall = 1.2 })
	r:eye(V(0.38, 4.75, -0.71), 0.46, C(175, 70, 255), "Head", { glow = true, tall = 1.2 })
	r:add({ sz = V(0.45, 0.2, 0.08), p = V(0, 4.3, -0.71), c = C(120, 30, 60), j = "Head" })
	r:add({ s = "box", sz = V(0.07, 0.1, 0.04), p = V(0.1, 4.36, -0.75), c = C(255, 255, 255), j = "Head" })
	r:sym({ sz = V(0.28, 0.16, 0.06), p = V(-0.58, 4.42, -0.71), c = C(255, 160, 190), j = "Head" })
	-- long lavender hair
	r:add({ sz = V(2.0, 2.6, 1.0), p = V(0, 4.0, 0.6), c = HAIR, j = "Head" })
	r:sym({ sz = V(0.6, 2.3, 1.0), p = V(-0.92, 4.0, -0.05), c = HAIR2, j = "Head" })
	r:sym({ sz = V(0.55, 0.6, 0.55), p = V(-0.95, 2.85, 0.1), c = HAIR, j = "Head" })
	r:add({ sz = V(1.9, 0.7, 1.6), p = V(0, 5.45, 0.05), c = HAIR, j = "Head" })
	for k = -2, 2 do
		r:add({ sz = V(0.5, 0.55, 0.35), p = V(k * 0.33, 5.3, -0.7), r = V(15, 0, k * 10), c = (k % 2 == 0) and HAIR or HAIR2, j = "Head" })
	end

	-- the big witch hat
	r:add({ s = "cyl", sz = V(3.6, 0.14, 3.6), p = V(0, 5.6, 0), c = FRILL, j = "Head" })
	r:add({ s = "cyl", sz = V(3.4, 0.16, 3.4), p = V(0, 5.68, 0), c = PURPLE_D, j = "Head" })
	r:ring(14, function(i, a)
		return { s = "box", sz = V(0.12, 0.12, 0.05), p = V(math.sin(a) * 1.6, 5.77, math.cos(a) * 1.6), r = V(0, math.deg(a), 45), c = GOLD, m = NEON, j = "Head" }
	end)
	local cone = { { 1.85, 0.6, 5.98, 0, 0 }, { 1.5, 0.55, 6.5, 0, 0.05 }, { 1.15, 0.5, 6.98, 0.05, 0.15 }, { 0.82, 0.45, 7.4, 0.15, 0.3 }, { 0.52, 0.4, 7.75, 0.3, 0.48 } }
	for _, cc in cone do
		r:add({ s = "cyl", sz = V(cc[1], cc[2], cc[1]), p = V(cc[4], cc[3], cc[5]), c = PURPLE_D, j = "Head" })
	end
	r:add({ s = "ball", sz = V(0.32, 0, 0), p = V(0.48, 8.0, 0.66), c = PURPLE_D, j = "Head" })
	star(r, V(0.55, 7.75, 0.82), 0.2, "Head")
	r:add({ s = "cyl", sz = V(1.9, 0.32, 1.9), p = V(0, 6.0, 0), c = LILAC, j = "Head" })
	r:sym({ sz = V(0.7, 0.5, 0.25), p = V(-0.5, 6.05, -0.92), r = V(0, 0, 20), c = LILAC, j = "Head" })
	r:add({ sz = V(0.3, 0.3, 0.2), p = V(0, 6.05, -0.95), c = PURPLE, j = "Head" })
	r:add({ s = "box", sz = V(0.06, 0.4, 0.06), p = V(0.12, 7.0, -0.58), r = V(-10, 0, 0), c = LILAC, j = "Head" })
	r:add({ s = "box", sz = V(0.06, 0.4, 0.06), p = V(-0.1, 6.6, -0.75), r = V(-10, 0, 0), c = LILAC, j = "Head" })
	-- gold stars hanging from the brim
	for _, p in { V(-1.45, 5.25, -0.55), V(1.5, 5.15, -0.3), V(1.2, 5.3, 0.9), V(-1.0, 5.2, 1.2) } do
		r:add({ s = "box", sz = V(0.03, 0.45, 0.03), p = p + V(0, 0.32, 0), c = GOLD, j = "Head" })
		star(r, p, 0.2, "Head")
	end
	-- crescent moon on the back of the hat
	r:add({ sz = V(0.5, 0.5, 0.08), p = V(0, 6.1, 0.97), c = GOLD, m = NEON, j = "Head" })
	r:add({ sz = V(0.42, 0.42, 0.09), p = V(0.12, 6.15, 0.98), c = LILAC, j = "Head" })

	r:emitter("ArmR", { Rate = 8, Lifetime = NumberRange.new(0.8, 1.4), Speed = NumberRange.new(0.5, 1.2), SpreadAngle = Vector2.new(60, 60), Size = NumberSequence.new(0.25, 0), Color = ColorSequence.new(POTION, C(255, 200, 255)), EmissionDirection = Enum.NormalId.Top })
	r:emitter("Body", { Rate = 4, Lifetime = NumberRange.new(1, 1.6), Speed = NumberRange.new(0.3, 0.8), SpreadAngle = Vector2.new(180, 180), Size = NumberSequence.new(0.22, 0), Color = ColorSequence.new(GOLD, LILAC) })
	r:light("ArmR", POTION, 1.4, 10)
	return r:finish("WitchinaMagichina", "potion")
end
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">ZombinoRotolino</string><ProtectedString name="Source"><![CDATA[-- Zombino Rotolino (Epic): a blocky zombie. Cracked stone head covered in moss with red
-- mushrooms and leaf sprouts, green face with glowing yellow eyes and a toothy mouth
-- dripping slime, torn grey jacket with an orange tie and ribs showing, green blocky
-- arms, torn shorts with a bone sticking out, big muddy brown boots, flies buzzing around.
local Rig = require(script.Parent.Parent.Rig)
local C, V = Color3.fromRGB, Vector3.new

local ZGREEN = C(115, 195, 70)
local ZGREEN2 = C(90, 165, 55)
local STONE = C(155, 152, 145)
local MOSS = C(85, 145, 40)
local JACKET = C(72, 72, 78)
local TIE = C(235, 125, 30)
local BONE = C(240, 225, 190)
local BOOT = C(115, 72, 40)
local SLIME = C(140, 255, 60)
local NEON = Enum.Material.Neon
local SLATE = Enum.Material.Slate
local GRASS = Enum.Material.Grass

local function mushroom(r, p: Vector3, s: number)
	r:add({ s = "cyl", sz = V(0.18 * s, 0.35 * s, 0.18 * s), p = p, c = BONE, j = "Head" })
	r:add({ sz = V(0.62 * s, 0.38 * s, 0.62 * s), p = p + V(0, 0.22 * s, 0), c = C(220, 40, 40), j = "Head" })
	r:add({ s = "ball", sz = V(0.12 * s, 0, 0), p = p + V(0.12 * s, 0.38 * s, -0.08 * s), c = C(255, 255, 255), j = "Head" })
	r:add({ s = "ball", sz = V(0.1 * s, 0, 0), p = p + V(-0.14 * s, 0.34 * s, 0.1 * s), c = C(255, 255, 255), j = "Head" })
end

return function(): Model
	local r = Rig.new("ZombinoRotolino", 2.0)
	r:symJoint("LegL", V(-0.55, 1.85, 0))
	r:symJoint("ArmL", V(-1.35, 3.55, 0))
	r:joint("Head", V(0, 3.8, 0))
	r:joint("Flies", V(0, 4.8, 0))

	-- big muddy boots
	r:sym({ s = "box", sz = V(1.1, 0.75, 1.45), p = V(-0.55, 0.4, -0.15), c = BOOT, j = "LegL" })
	r:sym({ s = "box", sz = V(1.15, 0.2, 1.5), p = V(-0.55, 0.1, -0.15), c = C(70, 45, 25), j = "LegL" })
	r:sym({ s = "box", sz = V(1.15, 0.12, 0.5), p = V(-0.55, 0.65, 0.1), c = C(90, 58, 30), j = "LegL" })
	r:sym({ sz = V(0.5, 0.18, 0.4), p = V(-0.75, 0.75, -0.6), c = MOSS, m = GRASS, j = "LegL" })
	-- green legs, torn shorts, a bone
	r:sym({ s = "box", sz = V(0.75, 1.0, 0.75), p = V(-0.55, 1.25, 0), c = ZGREEN, j = "LegL" })
	r:sym({ s = "box", sz = V(0.98, 0.55, 0.98), p = V(-0.55, 1.75, 0), c = C(60, 60, 66), j = "LegL" })
	r:add({ s = "box", sz = V(0.22, 0.55, 0.22), p = V(-0.35, 1.2, -0.38), r = V(0, 0, 15), c = BONE, j = "LegL" })
	r:add({ s = "ball", sz = V(0.25, 0, 0), p = V(-0.28, 1.48, -0.4), c = BONE, j = "LegL" })
	r:add({ s = "box", sz = V(0.5, 0.35, 0.05), p = V(0.5, 1.15, -0.39), r = V(0, 0, 20), c = ZGREEN2, j = "LegR" })

	-- torn jacket, shirt, tie and ribs
	r:add({ s = "box", sz = V(2.0, 1.85, 1.1), p = V(0, 2.95, 0), c = JACKET })
	r:add({ s = "box", sz = V(0.85, 1.7, 0.05), p = V(0, 2.95, -0.56), c = C(200, 170, 110) })
	r:add({ s = "box", sz = V(0.3, 1.05, 0.06), p = V(0, 2.8, -0.6), c = TIE })
	r:add({ s = "box", sz = V(0.36, 0.25, 0.07), p = V(0, 3.45, -0.6), r = V(0, 0, 45), c = TIE })
	for k = 0, 2 do
		r:add({ s = "box", sz = V(0.55, 0.08, 0.06), p = V(0.45, 2.55 + k * 0.22, -0.6), c = BONE })
	end
	r:add({ s = "box", sz = V(0.4, 0.4, 0.05), p = V(-0.6, 2.45, -0.57), r = V(0, 0, 15), c = ZGREEN2 })
	r:add({ s = "box", sz = V(0.5, 0.5, 0.05), p = V(0.3, 3.0, 0.57), r = V(0, 0, 10), c = TIE })
	for k = 0, 3 do
		r:add({ s = "box", sz = V(0.3, 0.35, 0.05), p = V(-0.75 + k * 0.5, 2.06, -0.56), r = V(0, 0, 45), c = JACKET })
	end
	r:add({ sz = V(0.7, 0.3, 0.35), p = V(-0.75, 3.85, -0.2), c = MOSS, m = GRASS })
	r:add({ sz = V(0.5, 0.3, 0.3), p = V(0.8, 3.8, 0.3), c = MOSS, m = GRASS })

	-- arms reaching forward like a zombie (the Gait lifts them)
	r:sym({ s = "box", sz = V(0.88, 0.8, 0.88), p = V(-1.4, 3.3, 0), c = JACKET, j = "ArmL" })
	r:sym({ s = "box", sz = V(0.75, 1.3, 0.75), p = V(-1.4, 2.35, 0), c = ZGREEN, j = "ArmL" })
	r:sym({ s = "box", sz = V(0.85, 0.6, 0.85), p = V(-1.4, 1.45, 0), c = ZGREEN2, j = "ArmL" })
	for k = -1, 1 do
		r:sym({ s = "box", sz = V(0.18, 0.4, 0.18), p = V(-1.4 + k * 0.25, 1.05, -0.25), c = ZGREEN, j = "ArmL" })
	end

	-- head: cracked mossy stone on top, green face below
	r:add({ s = "box", sz = V(2.0, 1.75, 1.75), p = V(0, 4.8, 0), c = STONE, m = SLATE, j = "Head" })
	r:add({ s = "box", sz = V(1.9, 0.95, 0.1), p = V(0, 4.32, -0.88), c = ZGREEN, j = "Head" })
	r:sym({ s = "box", sz = V(0.1, 0.95, 1.6), p = V(-0.99, 4.3, 0), c = ZGREEN2, j = "Head" })
	r:sym({ s = "box", sz = V(0.62, 0.58, 0.08), p = V(-0.45, 4.72, -0.92), c = C(20, 25, 15), j = "Head" })
	r:sym({ s = "ball", sz = V(0.46, 0, 0), p = V(-0.45, 4.72, -0.92), c = C(255, 240, 60), m = NEON, j = "Head" })
	r:add({ s = "box", sz = V(1.15, 0.52, 0.08), p = V(0, 4.08, -0.93), c = C(60, 10, 15), j = "Head" })
	for k = -2, 2 do
		r:add({ s = "box", sz = V(0.15, 0.16, 0.05), p = V(k * 0.22, 4.27, -0.97), c = BONE, j = "Head" })
		r:add({ s = "box", sz = V(0.14, 0.13, 0.05), p = V(k * 0.22 + 0.1, 3.9, -0.97), c = BONE, j = "Head" })
	end
	r:add({ sz = V(0.15, 0.55, 0.12), p = V(-0.4, 3.75, -0.95), c = SLIME, m = NEON, j = "Head" })
	r:add({ sz = V(0.12, 0.4, 0.1), p = V(0.35, 3.8, -0.95), c = SLIME, m = NEON, j = "Head" })
	r:add({ sz = V(0.12, 0.35, 0.1), p = V(-0.8, 3.95, -0.92), c = SLIME, m = NEON, j = "Head" })
	-- stitches and cracks
	r:add({ s = "box", sz = V(0.06, 0.6, 0.04), p = V(0.6, 5.35, -0.89), r = V(0, 0, 10), c = C(120, 30, 30), j = "Head" })
	for k = 0, 2 do
		r:add({ s = "box", sz = V(0.22, 0.05, 0.04), p = V(0.6, 5.15 + k * 0.18, -0.9), c = C(120, 30, 30), j = "Head" })
	end
	r:add({ s = "box", sz = V(0.05, 0.5, 0.04), p = V(-0.5, 5.4, -0.89), r = V(0, 0, -30), c = C(100, 98, 92), j = "Head" })
	-- moss, mushrooms and sprouts on top
	r:add({ s = "box", sz = V(1.3, 0.2, 1.0), p = V(-0.25, 5.72, -0.2), c = MOSS, m = GRASS, j = "Head" })
	r:add({ s = "box", sz = V(0.8, 0.18, 0.9), p = V(0.5, 5.7, 0.45), c = MOSS, m = GRASS, j = "Head" })
	r:add({ s = "box", sz = V(0.7, 0.5, 0.12), p = V(-0.65, 5.3, -0.88), c = MOSS, m = GRASS, j = "Head" })
	mushroom(r, V(0.55, 5.9, -0.3), 1.2)
	mushroom(r, V(-0.75, 5.85, 0.4), 0.9)
	mushroom(r, V(1.0, 4.9, 0.3), 0.8)
	r:add({ s = "box", sz = V(0.06, 0.4, 0.06), p = V(0, 5.95, 0.2), c = MOSS, j = "Head" })
	r:sym({ sz = V(0.4, 0.12, 0.25), p = V(-0.18, 6.15, 0.2), r = V(0, 0, 30), c = C(130, 210, 60), j = "Head" })

	-- buzzing flies (spin around the head)
	for k = 0, 4 do
		local a = k / 5 * math.pi * 2
		r:add({ s = "ball", sz = V(0.16, 0, 0), p = V(math.cos(a) * 1.7, 4.6 + (k % 3) * 0.35, math.sin(a) * 1.7), c = C(20, 20, 20), j = "Flies" })
		r:add({ sz = V(0.18, 0.04, 0.1), p = V(math.cos(a) * 1.7, 4.7 + (k % 3) * 0.35, math.sin(a) * 1.7), c = C(220, 230, 255), t = 0.4, j = "Flies" })
	end

	r:emitter("Head", { Rate = 2, Lifetime = NumberRange.new(0.6, 0.9), Speed = NumberRange.new(0.5, 1), Acceleration = Vector3.new(0, -8, 0), Size = NumberSequence.new(0.18, 0.05), Color = ColorSequence.new(SLIME), EmissionDirection = Enum.NormalId.Front })
	r:light("Head", SLIME, 0.7, 8)
	return r:finish("ZombinoRotolino", "limp")
end
]]></ProtectedString></Properties></Item>
</Item>
<Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[-- EVOLVE YOUR WORLD: all the numbers of the game in one place.
-- Change a number here and the whole game follows it.

local Config = {
	PlayerWalkSpeed = 16,
	-- Every material and creature walks 30% slower than the player (Adam's rule).
	ItemWalkSpeed = 16 * 0.7,

	-- Red carpet: a new item comes out of the black box every second.
	SpawnInterval = 1,
	CarpetStartX = -124,
	CarpetEndX = 126,

	StartMoney = 1,

	-- Machines (green tanks): start with 6 (3 each side), up to 10 (5 each side).
	StartMachines = 6,
	MaxMachines = 10,
	MachinePrices = {
		[7] = 25000,
		[8] = 1000000,
		[9] = 50000000,
		[10] = 500000000,
	},
	-- Robux: create a Developer Product for each machine in the Creator Hub
	-- (Monetization > Developer Products) and paste its number here.
	-- While it is 0 the game only tells the player they need more money.
	MachineRobuxProducts = {
		[7] = 0,
		[8] = 0,
		[9] = 0,
		[10] = 0,
	},

	-- Selling gives back 90% of the price (10% loss).
	SellReturn = 0.9,

	-- Money keeps growing while you are offline: 10% of normal, for at most 2 hours.
	OfflineRate = 0.10,
	OfflineMaxSeconds = 2 * 60 * 60,

	DataStoreName = "EvolveYourWorld_v1",
	AutosaveSeconds = 60,

	-- 10 bases, 5 on each side of the red carpet.
	PlotXs = { -96, -48, 0, 48, 96 },
	PlotZ = 46,
	PlotSize = Vector3.new(44, 1, 58),

	-- The big sphere grows with every new machine.
	SphereBaseRadius = 9,
	SphereGrowPerMachine = 1.2,
}

function Config.sphereRadius(machines: number): number
	return Config.SphereBaseRadius + math.max(0, machines - Config.StartMachines) * Config.SphereGrowPerMachine
end

return Config
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">Gait</string><ProtectedString name="Source"><![CDATA[--[[
	Gait: makes every character walk in its own style by turning its joints.
	Runs on the client (smooth, no lag). Call Gait.update(model, dt, speed, t) every frame.

	cute    - bouncy happy walk (Grass and Flowers, Magic Tree)
	strut   - millionaire walk, chest out, big arm swing (Blue Crystal)
	bully   - wide swaggering walk (Lava Stone)
	skip    - slow skipping, cape flying (Giraffe)
	tiny    - quick little steps (Cosmic Meteor)
	quad    - four legs, swinging tail and mane (Solario, Frosty)
	dragon  - four legs plus flapping wings (Galaxy Dragon)
	phone   - walking while looking at the phone (Drippo Bloxino)
	limp    - zombie limp with arms forward (Zombino Rotolino)
	potion  - walking holding up a potion (Witchina Magichina)
]]

local Gait = {}

type State = { motors: { [string]: Motor6D }, phase: number, amount: number, gait: string, seed: number }
local states: { [Model]: State } = setmetatable({}, { __mode = "k" }) :: any

local sin, cos, abs, min = math.sin, math.cos, math.abs, math.min
local A = CFrame.Angles

local function state(model: Model): State
	local s = states[model]
	if not s then
		local motors = {}
		for _, d in model:GetDescendants() do
			if d:IsA("Motor6D") then
				motors[d.Name] = d
			end
		end
		s = {
			motors = motors,
			phase = 0,
			amount = 0,
			gait = (model:GetAttribute("Gait") :: string?) or "cute",
			seed = math.random() * 10,
		}
		states[model] = s
	end
	return s
end

local function set(m: { [string]: Motor6D }, name: string, cf: CFrame)
	local motor = m[name]
	if motor then
		motor.Transform = cf
	end
end

-- how fast the legs cycle for each gait (per stud moved)
local STRIDE = {
	cute = 1.15, strut = 0.95, bully = 0.9, skip = 0.7, tiny = 2.0,
	quad = 0.75, dragon = 0.6, phone = 1.0, limp = 0.9, potion = 1.0,
}

function Gait.update(model: Model, dt: number, speed: number, t: number, opts: { [string]: any }?)
	local s = state(model)
	local m = s.motors
	local target = min(speed / 8, 1)
	s.amount += (target - s.amount) * min(dt * 8, 1)
	local a = s.amount
	s.phase += dt * speed * (STRIDE[s.gait] or 1)
	local ph = s.phase
	local tt = t + s.seed
	local breathe = sin(tt * 2) * 0.03
	local g = s.gait

	-- things every model may have
	set(m, "Halo", A(0, tt * 1.5, 0))
	set(m, "Flies", A(0, tt * 5, 0) * A(sin(tt * 3) * 0.1, 0, 0))
	set(m, "Flame", A(sin(tt * 9) * 0.06, 0, cos(tt * 7) * 0.06))
	set(m, "Cape", A(-(0.12 + 0.35 * a + sin(tt * 7) * 0.08 * (0.3 + a)), 0, sin(tt * 3) * 0.04))
	set(m, "Mane", A(sin(tt * 2.1) * 0.04, 0, sin(tt * 1.7) * 0.06 * (0.5 + a)))
	set(m, "Tail", A(sin(tt * 2.5) * 0.15, sin(tt * 3 + ph) * (0.25 + 0.2 * a), 0))

	if g == "quad" or g == "dragon" then
		local sw = sin(ph) * 0.55 * a
		set(m, "LegFL", A(sw, 0, 0))
		set(m, "LegBR", A(sw, 0, 0))
		set(m, "LegFR", A(-sw, 0, 0))
		set(m, "LegBL", A(-sw, 0, 0))
		set(m, "Body", CFrame.new(0, abs(sin(ph)) * 0.12 * a + breathe, 0) * A(sin(ph * 2) * 0.02 * a, 0, sin(ph) * 0.03 * a))
		set(m, "Head", A(sin(ph * 2) * 0.05 * a + sin(tt * 0.9) * 0.04, sin(tt * 0.7) * 0.12, 0))
		set(m, "Neck", A(sin(tt * 1.1) * 0.05, 0, 0))
		if g == "dragon" then
			local flap = sin(tt * (2.2 + a * 2)) * (0.35 + 0.25 * a)
			set(m, "WingL", A(0, 0, flap - 0.1))
			set(m, "WingR", A(0, 0, -flap + 0.1))
		end
		return
	end

	local sw = sin(ph)
	local legAmp, armAmp, bounce = 0.6, 0.5, 0.15
	local body = CFrame.identity
	local head = A(sin(tt * 1.3) * 0.04, sin(tt * 0.8) * 0.08, sin(tt * 1.1) * 0.03)
	local armL, armR

	if g == "cute" then
		legAmp, armAmp, bounce = 0.55, 0.6, 0.3
		head *= A(0, 0, sin(ph) * 0.08 * a)
	elseif g == "strut" then
		legAmp, armAmp, bounce = 0.55, 0.85, 0.12
		body = A(-0.08 * a, sin(ph) * 0.12 * a, sin(ph) * 0.06 * a)
		head *= A(-0.08 * a, 0, 0)
	elseif g == "bully" then
		legAmp, armAmp, bounce = 0.5, 0.45, 0.1
		body = A(0, sin(ph) * 0.18 * a, sin(ph) * 0.14 * a)
		armL = A(-sw * 0.45 * a, 0, -0.35 * a)
		armR = A(sw * 0.45 * a, 0, 0.35 * a)
	elseif g == "skip" then
		legAmp, armAmp, bounce = 0.35, 0.5, 0.0
		local hop = abs(sin(ph)) * 0.65 * a
		body = CFrame.new(0, hop, 0) * A(-0.06 * a, 0, 0)
		armL = A(-0.4 * a - sw * 0.3 * a, 0, -0.3 * a)
		armR = A(-0.4 * a + sw * 0.3 * a, 0, 0.3 * a)
	elseif g == "tiny" then
		legAmp, armAmp, bounce = 0.45, 0.5, 0.22
		body = A(0, 0, sin(ph) * 0.1 * a)
	elseif g == "phone" then
		legAmp, armAmp, bounce = 0.55, 0.5, 0.1
		armR = A(2.05, 0, -0.25)
		head *= A(-0.3, 0, 0)
	elseif g == "potion" then
		legAmp, armAmp, bounce = 0.5, 0.35, 0.12
		armR = A(0.95 + sin(tt * 2) * 0.05, 0, 0.15)
		armL = A(0.25 - sw * 0.15 * a, 0, 0)
	elseif g == "limp" then
		legAmp, bounce = 0.0, 0.0
		local good = sw * 0.55 * a
		local drag = math.max(0, -sw) * 0.18 * a
		set(m, "LegL", A(good, 0, 0))
		set(m, "LegR", A(drag, 0, 0.05 * a))
		body = CFrame.new(0, math.max(0, sw) * 0.25 * a, 0) * A(0.06, sin(ph) * 0.1 * a, 0.12 * a + sin(ph) * 0.1 * a)
		armL = A(1.3 + sin(tt * 2.3) * 0.08, 0, 0.05)
		armR = A(1.15 + sin(tt * 2.0 + 1) * 0.08, 0, -0.05)
		head *= A(0, 0, 0.15 + sin(tt * 1.7) * 0.06)
	end

	if legAmp > 0 then
		set(m, "LegL", A(sw * legAmp * a, 0, 0))
		set(m, "LegR", A(-sw * legAmp * a, 0, 0))
	end
	set(m, "ArmL", armL or A(-sw * armAmp * a, 0, -0.05))
	set(m, "ArmR", armR or A(sw * armAmp * a, 0, 0.05))
	set(m, "Body", CFrame.new(0, abs(sw) * bounce * a + breathe, 0) * body)
	set(m, "Head", head)
end

-- Sleeping pose for the tank: everything relaxed, slowly breathing.
function Gait.sleep(model: Model, t: number)
	local s = state(model)
	local m = s.motors
	local tt = t + s.seed
	set(m, "Body", CFrame.new(0, sin(tt * 0.9) * 0.05, 0))
	set(m, "Head", A(-0.25 + sin(tt * 0.9) * 0.03, 0, 0.1))
	set(m, "ArmL", A(0.1, 0, -0.15))
	set(m, "ArmR", A(0.1, 0, 0.15))
	set(m, "Cape", A(-0.05, 0, 0))
	set(m, "Tail", A(0, sin(tt * 0.5) * 0.1, 0))
	set(m, "WingL", A(0, 0, 0.5))
	set(m, "WingR", A(0, 0, -0.5))
	set(m, "Halo", A(0, tt * 0.5, 0))
	set(m, "Flies", A(0, tt * 3, 0))
end

return Gait
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">ItemData</string><ProtectedString name="Source"><![CDATA[-- The 12 items of EVOLVE YOUR WORLD, exactly as Adam wrote them in the doc.
-- chance  = how often it comes out of the black box (Adam's percent; higher = more often)
-- price   = cost in game dollars
-- income  = dollars per second while its beam is on
-- beam    = colours of the laser from the tank to the sphere

local C = Color3.fromRGB

export type Item = {
	id: string,
	name: string,
	kind: string,
	rarity: string,
	chance: number,
	price: number,
	income: number,
	beam: { Color3 },
	walk: string,
	sphere: string,
	scale: number,
}

local Rarity = {
	Common = C(170, 220, 150),
	Rare = C(80, 160, 255),
	["Super Rare"] = C(255, 120, 60),
	Epic = C(190, 90, 255),
	Legendary = C(255, 205, 40),
	Mythic = C(255, 60, 120),
	Secret = C(255, 255, 255),
}

local list: { Item } = {
	{
		id = "GrassAndFlowers", name = "Grass and Flowers", kind = "Material", rarity = "Common",
		chance = 100, price = 1, income = 1,
		beam = { C(255, 120, 200), C(120, 230, 90) },
		walk = "Cute walk, leaves a sparkle trail that vanishes after 3 seconds",
		sphere = "Grass over the whole sphere and 5 flowers",
		scale = 1,
	},
	{
		id = "MagicTree", name = "Magic Tree", kind = "Material", rarity = "Rare",
		chance = 90, price = 50, income = 3,
		beam = { C(40, 120, 40), C(120, 220, 80), C(190, 255, 120) },
		walk = "Cute walk, leaves soil behind that disappears after 5 seconds",
		sphere = "10 trees of all kinds, leaves sometimes fall and grow back",
		scale = 1,
	},
	{
		id = "LavaStone", name = "Lava Stone", kind = "Material", rarity = "Super Rare",
		chance = 80, price = 400, income = 12,
		beam = { C(255, 50, 20), C(30, 10, 10), C(255, 120, 0) },
		walk = "Bully walk, puffs smoke every 3 seconds that vanishes after 2 seconds",
		sphere = "3 volcanoes that blow smoke every minute",
		scale = 1,
	},
	{
		id = "DrippoBloxino", name = "Drippo Bloxino", kind = "Creature", rarity = "Super Rare",
		chance = 80, price = 2500, income = 45,
		beam = { C(15, 15, 20), C(60, 60, 80), C(15, 15, 20) },
		walk = "Walks like a person, always on the phone",
		sphere = "Each person builds 3 buildings",
		scale = 1,
	},
	{
		id = "BlueCrystal", name = "Blue Crystal", kind = "Material", rarity = "Epic",
		chance = 70, price = 12000, income = 150,
		beam = { C(150, 230, 255), C(40, 120, 255) },
		walk = "Millionaire walk, leaves money behind",
		sphere = "Adds 10 sparkling blue crystals",
		scale = 1,
	},
	{
		id = "ZombinoRotolino", name = "Zombino Rotolino", kind = "Creature", rarity = "Epic",
		chance = 75, price = 50000, income = 450,
		beam = { C(60, 200, 40), C(20, 80, 20) },
		walk = "Limps, with flies around",
		sphere = "A zombie that walks and bites things (they grow back)",
		scale = 1,
	},
	{
		id = "CosmicMeteor", name = "Cosmic Meteor", kind = "Material", rarity = "Epic",
		chance = 45, price = 200000, income = 1400,
		beam = { C(130, 130, 140), C(170, 70, 255), C(255, 210, 60) },
		walk = "Cute little steps",
		sphere = "A meteor falls every 5 seconds",
		scale = 1,
	},
	{
		id = "Giraffe", name = "Giraffe", kind = "Material", rarity = "Legendary",
		chance = 65, price = 1000000, income = 5000,
		beam = { C(255, 150, 30), C(255, 230, 60) },
		walk = "Slow skipping, cape flying in the wind",
		sphere = "5 giraffes that eat from the trees, or just wander",
		scale = 1,
	},
	{
		id = "WitchinaMagichina", name = "Witchina Magichina", kind = "Creature", rarity = "Mythic",
		chance = 40, price = 6000000, income = 22000,
		beam = { C(150, 60, 255), C(220, 140, 255) },
		walk = "Walks holding a potion",
		sphere = "Stands and brews potions; sometimes throws one and plants glow purple",
		scale = 1,
	},
	{
		id = "FrostyFangolini", name = "Frosty Fangolini", kind = "Creature", rarity = "Secret",
		chance = 20, price = 40000000, income = 110000,
		beam = { C(240, 255, 255), C(120, 210, 255), C(40, 140, 255) },
		walk = "Walks on 4 legs, snowflakes all around",
		sphere = "Wanders and runs; steam when it passes a volcano",
		scale = 1.25,
	},
	{
		id = "SolarioLeonario", name = "Solario Leonario", kind = "Creature", rarity = "Secret",
		chance = 20, price = 250000000, income = 550000,
		beam = { C(255, 240, 120), C(255, 190, 20) },
		walk = "Glows like the sun, 4 legs, mane swaying in the wind",
		sphere = "A lion that rests, walks, and hunts giraffes",
		scale = 1.25,
	},
	{
		id = "GalaxyDragon", name = "Galaxy Dragon", kind = "Creature", rarity = "Secret",
		chance = 10, price = 1000000000, income = 1800000,
		beam = { C(40, 10, 90), C(170, 60, 255), C(80, 160, 255), C(255, 120, 230) },
		walk = "Walks and breathes fire",
		sphere = "Hovers with wings; burns falling meteors into fireworks",
		scale = 1.35,
	},
}

local ItemData = {
	list = list,
	byId = {} :: { [string]: Item },
	rarityColor = Rarity,
	totalChance = 0,
}

for _, item in list do
	ItemData.byId[item.id] = item
	ItemData.totalChance += item.chance
end

function ItemData.beamSequence(id: string): ColorSequence
	local cols = ItemData.byId[id].beam
	if #cols == 1 then
		return ColorSequence.new(cols[1])
	end
	local keys = {}
	for i, c in cols do
		table.insert(keys, ColorSequenceKeypoint.new((i - 1) / (#cols - 1), c))
	end
	return ColorSequence.new(keys)
end

-- Pick a random item: bigger chance = comes out more often.
function ItemData.roll(rng: Random): Item
	local x = rng:NextNumber() * ItemData.totalChance
	for _, item in list do
		x -= item.chance
		if x <= 0 then
			return item
		end
	end
	return list[1]
end

return ItemData
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">Rig</string><ProtectedString name="Source"><![CDATA[--[[
	Rig: a small toolkit for building characters out of smooth parts.

	Every character is built standing on the ground (y = 0), facing -Z (the front).
	Parts are attached to named joints ("Body", "Head", "LegL", "ArmR", "Tail", "Cape", ...).
	The Gait module moves those joints to make each character walk in its own way.

	Shapes:
	  "ell"  smooth ellipsoid (a sphere you can stretch) - the main shape, keeps things round
	  "ball" perfect sphere
	  "box"  block
	  "cyl"  vertical cylinder: sz = (diameter X, height, diameter Z)
	  "wedge" wedge part
]]

local Config = require(script.Parent.Config)

local Rig = {}
Rig.__index = Rig

local rad = math.rad

export type Spec = {
	s: string?, -- shape
	sz: Vector3, -- size
	p: Vector3, -- position (ground space)
	r: Vector3?, -- rotation in degrees (x, y, z)
	c: Color3?, -- colour
	m: Enum.Material?, -- material
	t: number?, -- transparency
	j: string?, -- joint name (default "Body")
	n: string?, -- part name
	refl: number?,
}

local function newPart(shape: string): BasePart
	local p: BasePart
	if shape == "wedge" then
		p = Instance.new("WedgePart")
	else
		p = Instance.new("Part")
	end
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	return p
end

function Rig.new(name: string, hip: number)
	local self = setmetatable({}, Rig)
	local model = Instance.new("Model")
	model.Name = name
	local root = newPart("box")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1)
	root.Transparency = 1
	root.Massless = false
	root.CFrame = CFrame.new(0, hip, 0)
	root.Parent = model
	model.PrimaryPart = root
	self.model = model
	self.root = root
	self.hip = hip
	self.joints = {} :: { [string]: BasePart }
	self:joint("Body", Vector3.new(0, hip, 0))
	return self
end

-- A joint is an invisible pivot that the Gait module can rotate.
function Rig:joint(name: string, pos: Vector3, parent: string?): BasePart
	local parentPart: BasePart
	if name == "Body" then
		parentPart = self.root
	else
		parentPart = self.joints[parent or "Body"]
	end
	local p = newPart("box")
	p.Name = name
	p.Size = Vector3.new(0.2, 0.2, 0.2)
	p.Transparency = 1
	p.CFrame = CFrame.new(pos)
	p.Parent = self.model
	local m = Instance.new("Motor6D")
	m.Name = name
	m.Part0 = parentPart
	m.Part1 = p
	m.C0 = parentPart.CFrame:Inverse() * p.CFrame
	m.C1 = CFrame.identity
	m.Parent = parentPart
	self.joints[name] = p
	return p
end

function Rig:add(s: Spec): BasePart
	local shape = s.s or "ell"
	local p = newPart(shape)
	local cf = CFrame.new(s.p)
	if s.r then
		cf *= CFrame.fromOrientation(rad(s.r.X), rad(s.r.Y), rad(s.r.Z))
	end
	if shape == "ell" then
		p.Size = s.sz
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	elseif shape == "ball" then
		p.Shape = Enum.PartType.Ball
		p.Size = Vector3.new(s.sz.X, s.sz.X, s.sz.X)
	elseif shape == "cyl" then
		p.Shape = Enum.PartType.Cylinder
		p.Size = Vector3.new(s.sz.Y, s.sz.X, s.sz.Z)
		cf *= CFrame.Angles(0, 0, math.pi / 2)
	else
		p.Size = s.sz
	end
	p.Color = s.c or Color3.new(1, 1, 1)
	p.Material = s.m or Enum.Material.SmoothPlastic
	p.Transparency = s.t or 0
	if s.refl then
		p.Reflectance = s.refl
	end
	p.Name = s.n or "Part"
	p.CFrame = cf
	p.Parent = self.model
	local jp = self.joints[s.j or "Body"]
	local w = Instance.new("WeldConstraint")
	w.Part0 = jp
	w.Part1 = p
	w.Parent = p
	return p
end

local function mirrorSpec(s: Spec): Spec
	local m = table.clone(s)
	m.p = Vector3.new(-s.p.X, s.p.Y, s.p.Z)
	if s.r then
		m.r = Vector3.new(s.r.X, -s.r.Y, -s.r.Z)
	end
	if s.j then
		local j = s.j :: string
		if string.sub(j, -1) == "L" then
			m.j = string.sub(j, 1, -2) .. "R"
		elseif string.sub(j, -1) == "R" then
			m.j = string.sub(j, 1, -2) .. "L"
		end
	end
	return m
end

-- Adds the part and its mirror on the other side (left/right).
function Rig:sym(s: Spec): (BasePart, BasePart)
	return self:add(s), self:add(mirrorSpec(s))
end

-- Mirrors a joint too: "ArmL" at x=-1 also makes "ArmR" at x=+1.
function Rig:symJoint(name: string, pos: Vector3, parent: string?)
	self:joint(name, pos, parent)
	local other = string.sub(name, 1, -2) .. "R"
	local otherParent = parent
	if parent and string.sub(parent, -1) == "L" then
		otherParent = string.sub(parent, 1, -2) .. "R"
	end
	self:joint(other, Vector3.new(-pos.X, pos.Y, pos.Z), otherParent)
end

-- Ring of parts around a centre (petals, mane spikes, crown points...).
-- make(i, angle) returns a Spec.
function Rig:ring(count: number, make: (number, number) -> Spec)
	for i = 1, count do
		local a = (i - 1) / count * math.pi * 2
		self:add(make(i, a))
	end
end

-- Cartoon eye: white, coloured iris, black pupil, white shine.
-- pos is the centre of the eye surface, size the eye width.
function Rig:eye(pos: Vector3, size: number, iris: Color3, j: string?, opts: { [string]: any }?)
	local o = opts or {}
	local glow = o.glow
	local h = size * (o.tall or 1.15)
	if not o.noWhite then
		self:add({ sz = Vector3.new(size, h, size * 0.5), p = pos, c = Color3.new(1, 1, 1), j = j })
	end
	self:add({
		sz = Vector3.new(size * 0.72, h * 0.72, size * 0.4),
		p = pos + Vector3.new(0, -h * 0.04, -size * 0.12),
		c = iris,
		m = glow and Enum.Material.Neon or Enum.Material.SmoothPlastic,
		j = j,
	})
	if not o.noPupil then
		self:add({
			sz = Vector3.new(size * 0.36, h * 0.38, size * 0.3),
			p = pos + Vector3.new(0, -h * 0.04, -size * 0.2),
			c = Color3.fromRGB(15, 10, 10),
			j = j,
		})
	end
	self:add({
		s = "ball",
		sz = Vector3.new(size * 0.2, 0, 0),
		p = pos + Vector3.new(size * 0.14, h * 0.17, -size * 0.27),
		c = Color3.new(1, 1, 1),
		m = Enum.Material.Neon,
		j = j,
	})
end

function Rig:light(j: string, color: Color3, brightness: number, range: number)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Brightness = brightness
	l.Range = range
	l.Shadows = false
	l.Parent = self.joints[j]
end

-- Built-in particle textures work without uploading anything.
Rig.TEX = {
	sparkle = "rbxasset://textures/particles/sparkles_main.dds",
	smoke = "rbxasset://textures/particles/smoke_main.dds",
	fire = "rbxasset://textures/particles/fire_main.dds",
}

function Rig:emitter(j: string, props: { [string]: any }): ParticleEmitter
	local pe = Instance.new("ParticleEmitter")
	pe.LightEmission = 1
	pe.Texture = Rig.TEX.sparkle
	for k, v in props do
		(pe :: any)[k] = v
	end
	pe.Parent = self.joints[j]
	return pe
end

function Rig:finish(id: string, gait: string, scale: number?): Model
	local model = self.model
	model:SetAttribute("ItemId", id)
	model:SetAttribute("Gait", gait)
	local k = scale or 1
	model:SetAttribute("Hip", self.hip * k)
	local hum = Instance.new("Humanoid")
	hum.WalkSpeed = Config.ItemWalkSpeed
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.BreakJointsOnDeath = false
	hum.RequiresNeck = false
	hum.Parent = model
	if k ~= 1 then
		model:ScaleTo(k)
	end
	hum.HipHeight = (self.hip - 1) * k
	return model
end

return Rig
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">Util</string><ProtectedString name="Source"><![CDATA[local Util = {}

local SUFFIX = { "", "K", "M", "B", "T", "Qd" }

-- 1234 -> "$1.2K", 2500000 -> "$2.5M"
function Util.money(n: number): string
	n = math.floor(n + 0.5)
	if n < 1000 then
		return "$" .. tostring(n)
	end
	local i = 1
	local v = n
	while v >= 1000 and i < #SUFFIX do
		v /= 1000
		i += 1
	end
	local s
	if v >= 100 then
		s = string.format("%d", math.floor(v))
	elseif v >= 10 then
		s = string.format("%.1f", math.floor(v * 10) / 10)
	else
		s = string.format("%.2f", math.floor(v * 100) / 100)
	end
	if string.find(s, ".", 1, true) then
		s = string.gsub(s, "0+$", "")
		s = string.gsub(s, "%.$", "")
	end
	return "$" .. s .. SUFFIX[i]
end

function Util.part(props: { [string]: any }): BasePart
	local class = props.ClassName or "Part"
	local p = Instance.new(class) :: BasePart
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in props do
		if k ~= "ClassName" and k ~= "Parent" then
			(p :: any)[k] = v
		end
	end
	if props.Parent then
		p.Parent = props.Parent
	end
	return p
end

-- Vertical cylinder: diameter d, height h, centred at cf.
function Util.cylinder(cf: CFrame, d: number, h: number, props: { [string]: any }): BasePart
	props.Shape = Enum.PartType.Cylinder
	props.Size = Vector3.new(h, d, d)
	props.CFrame = cf * CFrame.Angles(0, 0, math.pi / 2)
	return Util.part(props)
end

function Util.billboard(adornee: Instance, size: UDim2, offset: Vector3, maxDist: number?): BillboardGui
	local bb = Instance.new("BillboardGui")
	bb.Size = size
	bb.StudsOffset = offset
	bb.AlwaysOnTop = false
	bb.LightInfluence = 0
	bb.MaxDistance = maxDist or 120
	bb.Adornee = adornee :: any
	bb.Parent = adornee
	return bb
end

function Util.label(parent: Instance, text: string, color: Color3, size: UDim2, pos: UDim2): TextLabel
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = size
	t.Position = pos
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.Text = text
	t.TextColor3 = color
	t.TextStrokeTransparency = 0
	t.TextStrokeColor3 = Color3.new(0, 0, 0)
	t.Parent = parent
	return t
end

return Util
]]></ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX0000001A"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX00000019"><Properties><string name="Name">Server</string></Properties><Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">Data</string><ProtectedString name="Source"><![CDATA[-- Saves and loads each player's progress (money, machines, what is in every tank).
-- In Roblox Studio, saving only works after:
--   Game Settings > Security > "Enable Studio Access to API Services" = ON
-- Without it the game still runs, it just starts fresh every time.

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)

local Data = {}

export type TankSave = { id: string, active: boolean }
export type Save = {
	money: number,
	pending: number,
	machines: number,
	tanks: { [string]: TankSave },
	tutorial: number,
	introSeen: boolean,
	lastSeen: number,
}

local store: DataStore? = nil
local ok = pcall(function()
	store = DataStoreService:GetDataStore(Config.DataStoreName)
end)
if not ok then
	warn("[EvolveYourWorld] DataStore not available - progress will not be saved (turn on API Services in Game Settings)")
end

function Data.default(): Save
	return {
		money = Config.StartMoney,
		pending = 0,
		machines = Config.StartMachines,
		tanks = {},
		tutorial = 1,
		introSeen = false,
		lastSeen = os.time(),
	}
end

function Data.load(userId: number): (Save, boolean)
	local s = store
	if not s then
		return Data.default(), true
	end
	for attempt = 1, 3 do
		local success, result = pcall(function()
			return s:GetAsync("u_" .. userId)
		end)
		if success then
			if type(result) == "table" then
				local d = Data.default()
				for k, v in result do
					(d :: any)[k] = v
				end
				return d, false
			end
			return Data.default(), true
		end
		warn("[EvolveYourWorld] load failed, attempt " .. attempt .. ": " .. tostring(result))
		task.wait(1)
	end
	return Data.default(), true
end

function Data.save(userId: number, save: Save)
	local s = store
	if not s then
		return
	end
	save.lastSeen = os.time()
	local success, err = pcall(function()
		s:SetAsync("u_" .. userId, save)
	end)
	if not success then
		warn("[EvolveYourWorld] save failed: " .. tostring(err))
	end
end

return Data
]]></ProtectedString></Properties></Item>
<Item class="Script" referent="RBX00000017"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--[[
	EVOLVE YOUR WORLD - the server.

	How the game works (from Adam's doc):
	 1. Every second a material or creature comes out of the black box and walks down the red carpet.
	 2. Walk up to it and buy it. It walks to your base (other players can still buy it on the way;
	    then you get your money back).
	 3. It goes into a free green tank and sleeps there, hanging from a wire.
	 4. Press the red button next to the tank: a laser beam shoots into the sphere, and the item's
	    world grows inside the sphere. From then on it earns money every second.
	 5. The money collects on the green pad. Stand on the pad to take it.
	 6. Sell an item from its tank (you get 90% back). Buy more machines on the blue pad
	    (machine 7 to 10, each one also makes the sphere bigger).
	 7. Everything is saved. While you are away you still earn 10%, for up to 2 hours.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local PhysicsService = game:GetService("PhysicsService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local ItemData = require(Shared.ItemData)
local Util = require(Shared.Util)
local Characters = require(Shared.Characters)
local Map = require(script.Parent.Map)
local Data = require(script.Parent.Data)

-- remotes -----------------------------------------------------------------------------
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local Notify = Instance.new("RemoteEvent")
Notify.Name = "Notify"
Notify.Parent = remotes
local Collected = Instance.new("RemoteEvent")
Collected.Name = "Collected"
Collected.Parent = remotes
local Bought = Instance.new("RemoteEvent")
Bought.Name = "Bought"
Bought.Parent = remotes
remotes.Parent = ReplicatedStorage

-- collision: walkers don't bump into players or each other ----------------------------
PhysicsService:RegisterCollisionGroup("Walkers")
PhysicsService:RegisterCollisionGroup("Players")
PhysicsService:CollisionGroupSetCollidable("Walkers", "Walkers", false)
PhysicsService:CollisionGroupSetCollidable("Walkers", "Players", false)

-- world --------------------------------------------------------------------------------
Map.buildWorld()
local plots = Map.buildPlots()
local walkers = Instance.new("Folder")
walkers.Name = "Brainrots"
walkers.Parent = workspace

type PState = {
	player: Player,
	plot: Model,
	save: Data.Save,
	money: NumberValue,
	reserved: { [number]: Model },
	loaded: boolean,
}
local states: { [Player]: PState } = {}

local function notify(player: Player, text: string, kind: string?)
	Notify:FireClient(player, text, kind or "info")
end

local function setMoney(st: PState, value: number)
	st.save.money = value
	st.money.Value = value
end

local function tankOf(plot: Model, i: number): Model?
	return (plot:FindFirstChild("Tanks") :: Folder):FindFirstChild("Tank" .. i) :: Model?
end

local function incomeOf(st: PState): number
	local total = 0
	for _, t in st.save.tanks do
		if t.active and ItemData.byId[t.id] then
			total += ItemData.byId[t.id].income
		end
	end
	return total
end

local function updateShop(plot: Model)
	local shop = plot:FindFirstChild("MachinePad") :: BasePart
	local label = (shop:FindFirstChild("Info") :: BillboardGui):FindFirstChild("Price") :: TextLabel
	local prompt = shop:FindFirstChild("BuyMachine") :: ProximityPrompt
	local m = plot:GetAttribute("Machines") :: number
	if m >= Config.MaxMachines then
		label.Text = "MAX"
		prompt.Enabled = false
	else
		label.Text = Util.money(Config.MachinePrices[m + 1])
		prompt.ObjectText = "Machine " .. (m + 1)
		prompt.Enabled = true
	end
end

local function updatePad(plot: Model)
	local pad = plot:FindFirstChild("CollectPad") :: BasePart
	local label = (pad:FindFirstChild("Info") :: BillboardGui):FindFirstChild("Amount") :: TextLabel
	label.Text = Util.money(plot:GetAttribute("Pending") :: number)
end

-- tanks --------------------------------------------------------------------------------
local function fitSleeper(tank: Model, plot: Model, id: string)
	local old = tank:FindFirstChild("Sleeper")
	if old then
		old:Destroy()
	end
	local info = tank:FindFirstChild("Info")
	if info then
		info:Destroy()
	end
	if id == "" then
		return
	end
	local m = Characters.buildStatic(id)
	m.Name = "Sleeper"
	local i = tank:GetAttribute("Index") :: number
	local tl = Map.tankLocal(i)
	local inward = plot:GetPivot():VectorToWorldSpace(Vector3.new((tl.X < 0) and 1 or -1, 0, 0))
	local yaw = math.atan2(-inward.X, -inward.Z)
	m:PivotTo(CFrame.new(m:GetPivot().Position) * CFrame.Angles(0, yaw, 0))
	local size = m:GetExtentsSize()
	local k = math.min(5.2 / size.Y, 3.6 / math.max(size.X, size.Z))
	m:ScaleTo(m:GetScale() * k)
	local center = (plot:GetPivot() * CFrame.new(tl + Vector3.new(0, 4.6, 0))).Position
	local bb = m:GetBoundingBox()
	m:PivotTo(m:GetPivot() + (center - bb.Position))
	m:SetAttribute("Base", m:GetPivot())
	m.Parent = tank

	local item = ItemData.byId[id]
	local cap = tank:FindFirstChild("Cap") :: BasePart
	local gui = Util.billboard(cap, UDim2.fromOffset(200, 64), Vector3.new(0, 3.2, 0), 70)
	gui.Name = "Info"
	gui.Parent = tank
	gui.Adornee = cap
	Util.label(gui, item.name, ItemData.rarityColor[item.rarity], UDim2.fromScale(1, 0.55), UDim2.fromScale(0, 0))
	local inc = Util.label(gui, Util.money(item.income) .. "/s", Color3.fromRGB(110, 255, 120), UDim2.fromScale(1, 0.45), UDim2.fromScale(0, 0.55))
	inc.Name = "Income"
end

local function setTank(plot: Model, i: number, id: string, active: boolean)
	local tank = tankOf(plot, i)
	if not tank then
		return
	end
	local changed = tank:GetAttribute("ItemId") ~= id
	tank:SetAttribute("ItemId", id)
	tank:SetAttribute("Active", active and id ~= "")
	if changed then
		fitSleeper(tank, plot, id)
	end
	local button = tank:FindFirstChild("Button") :: BasePart
	local activate = button:FindFirstChild("Activate") :: ProximityPrompt
	local sell = (tank:FindFirstChild("Glass") :: BasePart):FindFirstChild("Sell") :: ProximityPrompt
	activate.Enabled = id ~= "" and not active
	sell.Enabled = id ~= ""
	if id ~= "" then
		local item = ItemData.byId[id]
		activate.ObjectText = item.name
		sell.ObjectText = item.name .. "  +" .. Util.money(item.price * Config.SellReturn)
	end
	button.Color = (id ~= "" and not active) and Color3.fromRGB(255, 40, 40) or Color3.fromRGB(60, 255, 110)
	if id == "" then
		button.Color = Color3.fromRGB(120, 120, 130)
	end
end

local function hookTank(plot: Model, tank: Model)
	local i = tank:GetAttribute("Index") :: number
	local button = tank:FindFirstChild("Button") :: BasePart
	local activate = button:FindFirstChild("Activate") :: ProximityPrompt
	local sell = (tank:FindFirstChild("Glass") :: BasePart):FindFirstChild("Sell") :: ProximityPrompt

	activate.Triggered:Connect(function(player)
		local st = states[player]
		if not st or st.plot ~= plot or not st.loaded then
			return
		end
		local t = st.save.tanks[tostring(i)]
		if not t or t.active then
			return
		end
		t.active = true
		setTank(plot, i, t.id, true)
		local item = ItemData.byId[t.id]
		notify(player, item.name .. " launched into your world! +" .. Util.money(item.income) .. " every second", "good")
		if st.save.tutorial ~= 0 then
			st.save.tutorial = 0
			player:SetAttribute("Tutorial", 0)
		end
	end)

	sell.Triggered:Connect(function(player)
		local st = states[player]
		if not st or st.plot ~= plot or not st.loaded then
			return
		end
		local t = st.save.tanks[tostring(i)]
		if not t then
			return
		end
		local item = ItemData.byId[t.id]
		local back = math.floor(item.price * Config.SellReturn)
		st.save.tanks[tostring(i)] = nil
		setTank(plot, i, "", false)
		setMoney(st, st.save.money + back)
		notify(player, "Sold " .. item.name .. " for " .. Util.money(back), "money")
	end)
end

local function makeTank(plot: Model, i: number)
	if tankOf(plot, i) then
		return
	end
	local tank = Map.buildTank(plot, i)
	hookTank(plot, tank)
end

local function setMachines(st: PState, n: number)
	local plot = st.plot
	st.save.machines = n
	for i = 1, n do
		makeTank(plot, i)
	end
	plot:SetAttribute("Machines", n)
	Map.buildSphere(plot, Config.sphereRadius(n))
	updateShop(plot)
end

local function grantMachine(st: PState)
	if st.save.machines >= Config.MaxMachines then
		return
	end
	setMachines(st, st.save.machines + 1)
	notify(st.player, "New machine! Your sphere got bigger.", "good")
end

-- walkers on the red carpet ------------------------------------------------------------
local rng = Random.new()
local tokenCounter = 0

local function newToken(m: Model): number
	tokenCounter += 1
	m:SetAttribute("Walk", tokenCounter)
	return tokenCounter
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

-- Walks through the points. Returns false if the walk was replaced or the model is gone.
local function walkPath(m: Model, points: { Vector3 }, token: number): boolean
	local hum = m:FindFirstChildOfClass("Humanoid")
	local root = m.PrimaryPart
	if not hum or not root then
		return false
	end
	for _, p in points do
		local started = os.clock()
		local lastIssue = 0
		while true do
			if not m.Parent or m:GetAttribute("Walk") ~= token then
				return false
			end
			local d = (flat(root.Position) - flat(p)).Magnitude
			if d < 1.6 then
				break
			end
			if os.clock() - lastIssue > 3 then
				hum:MoveTo(p)
				lastIssue = os.clock()
			end
			if os.clock() - started > 40 then
				-- stuck: hop to the point
				m:PivotTo(CFrame.new(p + Vector3.new(0, (m:GetAttribute("Hip") :: number) + 0.5, 0)) * root.CFrame.Rotation)
				break
			end
			task.wait(0.1)
		end
	end
	return true
end

local function walkerLabel(m: Model, item: ItemData.Item)
	local root = m.PrimaryPart :: BasePart
	local size = m:GetExtentsSize()
	local hip = m:GetAttribute("Hip") :: number
	local bb = Util.billboard(root, UDim2.fromOffset(230, 118), Vector3.new(0, size.Y - hip + 2.2, 0), 75)
	bb.Name = "Tag"
	local owner = Util.label(bb, "", Color3.fromRGB(255, 255, 255), UDim2.fromScale(1, 0.18), UDim2.fromScale(0, 0))
	owner.Name = "Owner"
	Util.label(bb, item.name, Color3.fromRGB(255, 255, 255), UDim2.fromScale(1, 0.26), UDim2.fromScale(0, 0.18))
	local rar = Util.label(bb, item.rarity, ItemData.rarityColor[item.rarity], UDim2.fromScale(1, 0.2), UDim2.fromScale(0, 0.44))
	rar.Name = "Rarity"
	Util.label(bb, Util.money(item.price), Color3.fromRGB(255, 230, 80), UDim2.fromScale(1, 0.2), UDim2.fromScale(0, 0.64))
	Util.label(bb, Util.money(item.income) .. "/s", Color3.fromRGB(110, 255, 120), UDim2.fromScale(1, 0.16), UDim2.fromScale(0, 0.84))
end

local function freeTank(st: PState): number?
	for i = 1, st.save.machines do
		if not st.save.tanks[tostring(i)] and not st.reserved[i] then
			return i
		end
	end
	return nil
end

local function arrive(player: Player, m: Model, slot: number)
	local st = states[player]
	local id = m:GetAttribute("ItemId") :: string
	m:Destroy()
	if not st then
		return
	end
	st.reserved[slot] = nil
	st.save.tanks[tostring(slot)] = { id = id, active = false }
	setTank(st.plot, slot, id, false)
	notify(player, ItemData.byId[id].name .. " is in tank " .. slot .. ". Press the red button to launch the beam!", "info")
end

local function buy(player: Player, m: Model)
	local st = states[player]
	if not st or not st.loaded or not m.Parent then
		return
	end
	local state = m:GetAttribute("State")
	if state ~= "Carpet" and state ~= "ToBase" then
		return
	end
	local prevOwner = m:GetAttribute("OwnerUserId") :: number
	if prevOwner == player.UserId then
		return
	end
	local item = ItemData.byId[m:GetAttribute("ItemId") :: string]
	if st.save.money < item.price then
		notify(player, "Not enough money! " .. item.name .. " costs " .. Util.money(item.price), "bad")
		return
	end
	local slot = freeTank(st)
	if not slot then
		notify(player, "All your machines are full! Sell something or buy a new machine.", "bad")
		return
	end
	setMoney(st, st.save.money - item.price)

	if prevOwner ~= 0 then
		local prev = Players:GetPlayerByUserId(prevOwner)
		local prevSlot = m:GetAttribute("Slot") :: number?
		if prev and states[prev] then
			local pst = states[prev]
			setMoney(pst, pst.save.money + item.price)
			if prevSlot then
				pst.reserved[prevSlot] = nil
			end
			notify(prev, player.DisplayName .. " bought your " .. item.name .. " on the way! You got your money back.", "bad")
		end
	end

	st.reserved[slot] = m
	m:SetAttribute("State", "ToBase")
	m:SetAttribute("OwnerUserId", player.UserId)
	m:SetAttribute("Slot", slot)
	local tag = (m.PrimaryPart :: BasePart):FindFirstChild("Tag")
	if tag then
		(tag:FindFirstChild("Owner") :: TextLabel).Text = player.DisplayName .. "'s"
	end
	if st.save.tutorial == 1 then
		st.save.tutorial = 2
		player:SetAttribute("Tutorial", 2)
	end
	Bought:FireClient(player, item.id)
	notify(player, "You got " .. item.name .. "! It is walking to your base.", "good")

	local token = newToken(m)
	task.spawn(function()
		local ok = walkPath(m, Map.pathToTank(st.plot, slot), token)
		if ok and m.Parent and m:GetAttribute("OwnerUserId") == player.UserId and states[player] == st then
			arrive(player, m, slot)
		end
	end)
end

local function setGroup(m: Instance, group: string)
	for _, d in m:GetDescendants() do
		if d:IsA("BasePart") then
			d.CollisionGroup = group
		end
	end
end

local function spawnWalker(item: ItemData.Item)
	local m = Characters.build(item.id)
	m.Name = item.id
	m:SetAttribute("State", "Carpet")
	m:SetAttribute("OwnerUserId", 0)
	m:SetAttribute("Price", item.price)
	local root = m.PrimaryPart :: BasePart
	root.CanCollide = true
	setGroup(m, "Walkers")
	walkerLabel(m, item)

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "Buy"
	prompt.ActionText = "Buy  " .. Util.money(item.price)
	prompt.ObjectText = item.name
	prompt.HoldDuration = 0.25
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = root
	prompt.Triggered:Connect(function(player)
		buy(player, m)
	end)

	Characters.place(m, Vector3.new(Config.CarpetStartX, 0.2, 0), -math.pi / 2)
	m.Parent = walkers
	pcall(function()
		root:SetNetworkOwner(nil)
	end)

	local token = newToken(m)
	task.spawn(function()
		local ok = walkPath(m, { Vector3.new(Config.CarpetEndX, 0, 0) }, token)
		if ok and m.Parent and m:GetAttribute("State") == "Carpet" then
			m:SetAttribute("State", "Gone")
			task.wait(0.4)
			m:Destroy()
		end
	end)
end

task.spawn(function()
	task.wait(2)
	while true do
		spawnWalker(ItemData.roll(rng))
		task.wait(Config.SpawnInterval)
	end
end)

-- plots: shop pad, collect pad ---------------------------------------------------------
for _, plot in plots do
	for _, tank in (plot:FindFirstChild("Tanks") :: Folder):GetChildren() do
		hookTank(plot, tank :: Model)
	end
	updateShop(plot)
	updatePad(plot)

	local shop = plot:FindFirstChild("MachinePad") :: BasePart
	local buyMachine = shop:FindFirstChild("BuyMachine") :: ProximityPrompt
	buyMachine.Triggered:Connect(function(player)
		local st = states[player]
		if not st or st.plot ~= plot or not st.loaded then
			return
		end
		local nextN = st.save.machines + 1
		if nextN > Config.MaxMachines then
			return
		end
		local price = Config.MachinePrices[nextN]
		if st.save.money >= price then
			setMoney(st, st.save.money - price)
			grantMachine(st)
		else
			local product = Config.MachineRobuxProducts[nextN]
			if product and product ~= 0 then
				MarketplaceService:PromptProductPurchase(player, product)
			else
				notify(player, "You need " .. Util.money(price) .. " for machine " .. nextN, "bad")
			end
		end
	end)

	local pad = plot:FindFirstChild("CollectPad") :: BasePart
	local debounce: { [Player]: number } = {}
	pad.Touched:Connect(function(hit)
		local char = hit:FindFirstAncestorOfClass("Model")
		local player = char and Players:GetPlayerFromCharacter(char)
		if not player then
			return
		end
		local st = states[player]
		if not st or st.plot ~= plot or not st.loaded then
			return
		end
		if debounce[player] and os.clock() - debounce[player] < 0.6 then
			return
		end
		debounce[player] = os.clock()
		local amount = st.save.pending
		if amount < 1 then
			return
		end
		st.save.pending = 0
		plot:SetAttribute("Pending", 0)
		updatePad(plot)
		setMoney(st, st.save.money + amount)
		Collected:FireClient(player, amount, pad.Position)
	end)
end

-- income every second -------------------------------------------------------------------
task.spawn(function()
	while true do
		task.wait(1)
		for _, st in states do
			if st.loaded then
				local inc = incomeOf(st)
				if inc > 0 then
					st.save.pending += inc
					st.plot:SetAttribute("Pending", st.save.pending)
					st.plot:SetAttribute("Income", inc)
					updatePad(st.plot)
				else
					st.plot:SetAttribute("Income", 0)
				end
			end
		end
	end
end)

-- robux machines ------------------------------------------------------------------------
MarketplaceService.ProcessReceipt = function(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local st = states[player]
	if not st or not st.loaded then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	for _, pid in Config.MachineRobuxProducts do
		if pid ~= 0 and pid == info.ProductId then
			grantMachine(st)
			Data.save(player.UserId, st.save)
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

-- players --------------------------------------------------------------------------------
local function freePlot(): Model?
	for _, plot in plots do
		if plot:GetAttribute("OwnerUserId") == 0 then
			return plot
		end
	end
	return nil
end

local function resetPlot(plot: Model)
	for _, tank in (plot:FindFirstChild("Tanks") :: Folder):GetChildren() do
		local i = tank:GetAttribute("Index") :: number
		setTank(plot, i, "", false)
		if i > Config.StartMachines then
			tank:Destroy()
		end
	end
	plot:SetAttribute("OwnerUserId", 0)
	plot:SetAttribute("OwnerName", "")
	plot:SetAttribute("Machines", Config.StartMachines)
	plot:SetAttribute("Pending", 0)
	plot:SetAttribute("Income", 0)
	Map.buildSphere(plot, Config.sphereRadius(Config.StartMachines))
	local sign = (plot:FindFirstChild("GateTop") :: BasePart):FindFirstChild("Sign") :: BillboardGui
	local label = sign:FindFirstChild("OwnerName") :: TextLabel
	label.Text = "EMPTY BASE"
	label.TextTransparency = 0.5
	updateShop(plot)
	updatePad(plot)
end

local function onCharacter(st: PState, char: Model)
	char:WaitForChild("HumanoidRootPart", 10)
	task.wait(0.1)
	setGroup(char, "Players")
	char.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") then
			d.CollisionGroup = "Players"
		end
	end)
	char:PivotTo(Map.spawnPoint(st.plot))
end

Players.PlayerAdded:Connect(function(player)
	local plot = freePlot()
	if not plot then
		task.wait(2)
		notify(player, "This server is full (10 bases). Try another server!", "bad")
		return
	end
	plot:SetAttribute("OwnerUserId", player.UserId)
	plot:SetAttribute("OwnerName", player.DisplayName)

	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local money = Instance.new("NumberValue")
	money.Name = "Money"
	money.Parent = ls
	ls.Parent = player

	local st: PState = {
		player = player,
		plot = plot,
		save = Data.default(),
		money = money,
		reserved = {},
		loaded = false,
	}
	states[player] = st
	player:SetAttribute("PlotIndex", plot:GetAttribute("Index"))

	player.CharacterAdded:Connect(function(char)
		onCharacter(st, char)
	end)
	if player.Character then
		task.spawn(onCharacter, st, player.Character)
	end

	local save, isNew = Data.load(player.UserId)
	if not player.Parent then
		return
	end
	st.save = save
	setMoney(st, save.money)
	setMachines(st, math.clamp(save.machines, Config.StartMachines, Config.MaxMachines))
	for k, t in save.tanks do
		local i = tonumber(k)
		if i and ItemData.byId[t.id] then
			setTank(plot, i, t.id, t.active)
		else
			save.tanks[k] = nil
		end
	end

	local sign = (plot:FindFirstChild("GateTop") :: BasePart):FindFirstChild("Sign") :: BillboardGui
	local label = sign:FindFirstChild("OwnerName") :: TextLabel
	label.Text = player.DisplayName .. "'s Base"
	label.TextTransparency = 0

	local away = 0
	if not isNew then
		local seconds = math.clamp(os.time() - save.lastSeen, 0, Config.OfflineMaxSeconds)
		away = math.floor(incomeOf(st) * Config.OfflineRate * seconds)
		save.pending += away
	end
	plot:SetAttribute("Pending", save.pending)
	updatePad(plot)

	player:SetAttribute("Tutorial", save.tutorial)
	player:SetAttribute("FirstJoin", not save.introSeen)
	save.introSeen = true
	st.loaded = true

	if away > 0 then
		task.delay(4, function()
			notify(player, "While you were away you earned " .. Util.money(away) .. "! Go to the green pad.", "money")
		end)
	end
end)

Players.PlayerRemoving:Connect(function(player)
	local st = states[player]
	if not st then
		return
	end
	if st.loaded then
		Data.save(player.UserId, st.save)
	end
	states[player] = nil
	for _, m in walkers:GetChildren() do
		if m:GetAttribute("OwnerUserId") == player.UserId then
			m:Destroy()
		end
	end
	resetPlot(st.plot)
end)

task.spawn(function()
	while true do
		task.wait(Config.AutosaveSeconds)
		for player, st in states do
			if st.loaded then
				Data.save(player.UserId, st.save)
			end
		end
	end
end)

game:BindToClose(function()
	for player, st in states do
		if st.loaded then
			Data.save(player.UserId, st.save)
		end
	end
end)
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">Map</string><ProtectedString name="Source"><![CDATA[--[[
	Map: builds the whole world from code.
	  - grass ground, the red carpet with gold edges
	  - the black box where items come out, and the portal at the end where they vanish
	  - 10 bases (5 on each side of the carpet), each with:
	      gate + name sign, collect pad, "new machine" pad, green tanks, the big sphere
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local C, V = Color3.fromRGB, Vector3.new
local part, cylinder = Util.part, Util.cylinder

local Map = {}

Map.FLOOR_Y = 0.6

local function setupLighting()
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 2.2
	Lighting.Ambient = C(90, 90, 110)
	Lighting.OutdoorAmbient = C(140, 140, 160)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.GlobalShadows = true
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.6
	bloom.Size = 28
	bloom.Threshold = 1.6
	bloom.Parent = Lighting
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Saturation = 0.15
	cc.Contrast = 0.06
	cc.Parent = Lighting
	local atm = Instance.new("Atmosphere")
	atm.Density = 0.28
	atm.Color = C(200, 220, 255)
	atm.Decay = C(120, 140, 200)
	atm.Glare = 0.2
	atm.Haze = 1.2
	atm.Parent = Lighting
end

function Map.buildWorld(): Folder
	setupLighting()
	local world = Instance.new("Folder")
	world.Name = "World"
	world.Parent = workspace

	part({ Name = "Ground", Size = V(420, 2, 260), CFrame = CFrame.new(0, -1, 0), Color = C(95, 175, 75), Material = Enum.Material.Grass, Parent = world })

	-- red carpet with gold edges
	local len = Config.CarpetEndX - Config.CarpetStartX + 10
	local midX = (Config.CarpetEndX + Config.CarpetStartX) / 2
	part({ Name = "RedCarpet", Size = V(len, 0.2, 12), CFrame = CFrame.new(midX, 0.1, 0), Color = C(200, 20, 35), Material = Enum.Material.Fabric, Parent = world })
	for _, z in { -6.3, 6.3 } do
		part({ Name = "CarpetEdge", Size = V(len, 0.35, 0.6), CFrame = CFrame.new(midX, 0.17, z), Color = C(245, 195, 60), Material = Enum.Material.Metal, Parent = world })
	end
	-- golden posts with velvet ropes along the carpet
	for x = Config.CarpetStartX + 10, Config.CarpetEndX - 10, 20 do
		for _, z in { -7.4, 7.4 } do
			cylinder(CFrame.new(x, 1.5, z), 0.5, 3, { Name = "Post", Color = C(245, 195, 60), Material = Enum.Material.Metal, CanCollide = false, Parent = world })
			part({ Shape = Enum.PartType.Ball, Size = V(0.8, 0.8, 0.8), CFrame = CFrame.new(x, 3.2, z), Color = C(245, 195, 60), Material = Enum.Material.Metal, CanCollide = false, Parent = world })
		end
	end

	-- the black box where everything comes out
	local bx = Config.CarpetStartX - 6
	local box = part({ Name = "BlackBox", Size = V(14, 14, 18), CFrame = CFrame.new(bx, 7, 0), Color = C(12, 12, 16), Material = Enum.Material.SmoothPlastic, Parent = world })
	part({ Name = "BoxDoor", Size = V(0.4, 9, 11), CFrame = CFrame.new(bx + 7.05, 4.6, 0), Color = C(5, 5, 8), Material = Enum.Material.Neon, Parent = world })
	part({ Name = "BoxTrim", Size = V(0.5, 0.5, 12), CFrame = CFrame.new(bx + 7.1, 9.3, 0), Color = C(200, 20, 35), Material = Enum.Material.Neon, Parent = world })
	for _, z in { -5.8, 5.8 } do
		part({ Name = "BoxTrim", Size = V(0.5, 9.2, 0.5), CFrame = CFrame.new(bx + 7.1, 4.7, z), Color = C(200, 20, 35), Material = Enum.Material.Neon, Parent = world })
	end
	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
	smoke.Rate = 6
	smoke.Lifetime = NumberRange.new(1.5, 2.5)
	smoke.Speed = NumberRange.new(1, 2)
	smoke.Size = NumberSequence.new(2, 5)
	smoke.Transparency = NumberSequence.new(0.6, 1)
	smoke.Color = ColorSequence.new(C(40, 40, 50))
	smoke.EmissionDirection = Enum.NormalId.Right
	smoke.Parent = box
	local bb = Util.billboard(box, UDim2.fromOffset(300, 70), V(0, 9.5, 0), 250)
	Util.label(bb, "EVOLVE YOUR WORLD", C(255, 215, 70), UDim2.fromScale(1, 1), UDim2.fromScale(0, 0))

	-- the portal at the end of the carpet where unsold items disappear
	local ex = Config.CarpetEndX + 4
	local ring = part({ Name = "ExitPortal", Size = V(0.6, 10, 10), CFrame = CFrame.new(ex, 5, 0), Color = C(120, 60, 220), Material = Enum.Material.Neon, Transparency = 0.35, Parent = world })
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkle.Rate = 20
	sparkle.Lifetime = NumberRange.new(1, 1.5)
	sparkle.Speed = NumberRange.new(2, 4)
	sparkle.LightEmission = 1
	sparkle.Color = ColorSequence.new(C(200, 150, 255), C(120, 200, 255))
	sparkle.Parent = ring

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Size = V(8, 0.4, 8)
	spawn.CFrame = CFrame.new(0, 0.2, 18)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = world

	return world
end

-- Where tank number i stands, in the base's own coordinates (-Z points at the carpet).
function Map.tankLocal(i: number): Vector3
	local x = (i % 2 == 1) and -17 or 17
	local row = math.floor((i - 1) / 2)
	return V(x, Map.FLOOR_Y, -12 + row * 8.5)
end

function Map.sphereLocal(R: number): Vector3
	return V(0, Map.FLOOR_Y + 7 + R, 10)
end

function Map.buildTank(plot: Model, i: number): Model
	local cf = plot:GetPivot() * CFrame.new(Map.tankLocal(i))
	local tank = Instance.new("Model")
	tank.Name = "Tank" .. i
	tank:SetAttribute("Index", i)
	tank:SetAttribute("ItemId", "")
	tank:SetAttribute("Active", false)

	local metal = C(70, 75, 90)
	local base = cylinder(cf * CFrame.new(0, 0.6, 0), 5.2, 1.2, { Name = "Base", Color = metal, Material = Enum.Material.DiamondPlate, Parent = tank })
	cylinder(cf * CFrame.new(0, 1.25, 0), 5.4, 0.2, { Name = "Ring", Color = C(80, 255, 120), Material = Enum.Material.Neon, CanCollide = false, Parent = tank })
	local glass = cylinder(cf * CFrame.new(0, 4.8, 0), 4.5, 7, { Name = "Glass", Color = C(200, 255, 220), Material = Enum.Material.Glass, Transparency = 0.7, CanCollide = true, CastShadow = false, Parent = tank })
	cylinder(cf * CFrame.new(0, 4.6, 0), 4.1, 6.5, { Name = "Liquid", Color = C(60, 255, 100), Material = Enum.Material.Neon, Transparency = 0.82, CanCollide = false, CastShadow = false, Parent = tank })
	local cap = cylinder(cf * CFrame.new(0, 8.7, 0), 5.2, 0.9, { Name = "Cap", Color = metal, Material = Enum.Material.Metal, Parent = tank })
	cylinder(cf * CFrame.new(0, 9.35, 0), 1.6, 0.6, { Name = "Emitter", Color = C(80, 255, 120), Material = Enum.Material.Neon, Parent = tank })
	for _, a in { 0, 120, 240 } do
		local r = math.rad(a)
		part({ Name = "Pipe", Size = V(0.35, 7, 0.35), CFrame = cf * CFrame.new(math.cos(r) * 2.45, 4.8, math.sin(r) * 2.45), Color = metal, Material = Enum.Material.Metal, Parent = tank })
	end
	local out = Instance.new("Attachment")
	out.Name = "BeamOut"
	out.Position = cap.CFrame:PointToObjectSpace(cf * Vector3.new(0, 9.8, 0))
	out.Parent = cap

	local bubbles = Instance.new("ParticleEmitter")
	bubbles.Name = "Bubbles"
	bubbles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	bubbles.Rate = 6
	bubbles.Lifetime = NumberRange.new(1.5, 2.5)
	bubbles.Speed = NumberRange.new(1.5, 3)
	bubbles.SpreadAngle = Vector2.new(10, 10)
	bubbles.Size = NumberSequence.new(0.25, 0.4)
	bubbles.Transparency = NumberSequence.new(0.3, 1)
	bubbles.Color = ColorSequence.new(C(180, 255, 190))
	bubbles.LightEmission = 0.6
	bubbles.EmissionDirection = Enum.NormalId.Top
	bubbles.Parent = base

	-- the wire that holds the sleeping character
	part({ Name = "Wire", Size = V(0.12, 2.2, 0.12), CFrame = cf * CFrame.new(0, 7.2, 0), Color = C(25, 25, 30), CanCollide = false, Parent = tank })

	-- the launch button in front of the tank (towards the middle of the base)
	local inward = (Map.tankLocal(i).X < 0) and 1 or -1
	local bcf = cf * CFrame.new(inward * 4.3, 0, 0)
	cylinder(bcf * CFrame.new(0, 0.9, 0), 1.6, 1.8, { Name = "ButtonStand", Color = metal, Material = Enum.Material.Metal, Parent = tank })
	local button = cylinder(bcf * CFrame.new(0, 1.95, 0), 1.3, 0.35, { Name = "Button", Color = C(255, 40, 40), Material = Enum.Material.Neon, Parent = tank })

	local activate = Instance.new("ProximityPrompt")
	activate.Name = "Activate"
	activate.ActionText = "Launch Beam"
	activate.ObjectText = "Tank " .. i
	activate.HoldDuration = 0.2
	activate.MaxActivationDistance = 9
	activate.RequiresLineOfSight = false
	activate.Enabled = false
	activate:SetAttribute("OwnerOnly", true)
	activate.Parent = button

	local sell = Instance.new("ProximityPrompt")
	sell.Name = "Sell"
	sell.ActionText = "Sell"
	sell.HoldDuration = 1.2
	sell.KeyboardKeyCode = Enum.KeyCode.F
	sell.MaxActivationDistance = 9
	sell.RequiresLineOfSight = false
	sell.UIOffset = Vector2.new(0, 60)
	sell.Enabled = false
	sell:SetAttribute("OwnerOnly", true)
	sell.Parent = glass

	tank.PrimaryPart = base
	tank.Parent = plot:FindFirstChild("Tanks")
	return tank
end

function Map.buildSphere(plot: Model, R: number)
	local old = plot:FindFirstChild("SphereRig")
	if old then
		old:Destroy()
	end
	local rig = Instance.new("Model")
	rig.Name = "SphereRig"
	local pcf = plot:GetPivot()
	local center = (pcf * CFrame.new(Map.sphereLocal(R))).Position

	cylinder(pcf * CFrame.new(0, Map.FLOOR_Y + 3.5, 10), 6, 7, { Name = "Pedestal", Color = C(60, 65, 80), Material = Enum.Material.Metal, Parent = rig })
	cylinder(pcf * CFrame.new(0, Map.FLOOR_Y + 6.9, 10), 7.5, 0.5, { Name = "PedestalRing", Color = C(120, 220, 255), Material = Enum.Material.Neon, Parent = rig })
	local sphere = part({ Name = "Sphere", Shape = Enum.PartType.Ball, Size = V(R * 2, R * 2, R * 2), CFrame = CFrame.new(center), Color = C(150, 225, 255), Material = Enum.Material.Glass, Transparency = 0.78, CanCollide = false, CastShadow = false, Parent = rig })
	part({ Name = "Shell", Shape = Enum.PartType.Ball, Size = V(R * 2 - 0.5, R * 2 - 0.5, R * 2 - 0.5), CFrame = CFrame.new(center), Color = C(120, 210, 255), Material = Enum.Material.ForceField, Transparency = 0.1, CanCollide = false, CastShadow = false, Parent = rig })
	cylinder(CFrame.new(center), R * 2 + 0.7, 0.18, { Name = "Equator", Color = C(150, 235, 255), Material = Enum.Material.Neon, CanCollide = false, Parent = rig })
	local groundY = center.Y - R * 0.32
	cylinder(CFrame.new(center.X, groundY - 0.3, center.Z), R * 1.75, 0.6, { Name = "Land", Color = C(105, 85, 60), Material = Enum.Material.Ground, CanCollide = false, Parent = rig })
	cylinder(CFrame.new(center.X, groundY - 0.02, center.Z), R * 1.7, 0.08, { Name = "Soil", Color = C(125, 100, 70), Material = Enum.Material.Ground, CanCollide = false, Parent = rig })
	local inner = Instance.new("Attachment")
	inner.Name = "Center"
	inner.Parent = sphere
	local glow = Instance.new("PointLight")
	glow.Color = C(150, 220, 255)
	glow.Range = R * 1.6
	glow.Brightness = 1.2
	glow.Parent = sphere
	rig.Parent = plot

	plot:SetAttribute("SphereR", R)
	plot:SetAttribute("SphereCenter", center)
	plot:SetAttribute("GroundY", groundY)
end

function Map.buildPlot(index: number, cf: CFrame): Model
	local plot = Instance.new("Model")
	plot.Name = "Plot" .. index
	plot:SetAttribute("Index", index)
	plot:SetAttribute("OwnerUserId", 0)
	plot:SetAttribute("OwnerName", "")
	plot:SetAttribute("Machines", Config.StartMachines)
	plot:SetAttribute("Pending", 0)

	local S = Config.PlotSize
	local floor = part({ Name = "Floor", Size = V(S.X, 1, S.Z), CFrame = cf * CFrame.new(0, Map.FLOOR_Y - 0.5, 0), Color = C(200, 205, 220), Material = Enum.Material.Concrete, Parent = plot })
	plot.PrimaryPart = floor
	plot.WorldPivot = cf
	part({ Name = "FloorInlay", Size = V(S.X - 4, 0.05, S.Z - 4), CFrame = cf * CFrame.new(0, Map.FLOOR_Y + 0.02, 0), Color = C(225, 230, 240), Material = Enum.Material.Marble, CanCollide = false, Parent = plot })

	-- low walls on the sides and back, open in front
	local wallC = C(120, 200, 255)
	for _, x in { -S.X / 2 + 0.5, S.X / 2 - 0.5 } do
		part({ Name = "Wall", Size = V(1, 3, S.Z), CFrame = cf * CFrame.new(x, Map.FLOOR_Y + 1.5, 0), Color = C(235, 240, 250), Material = Enum.Material.SmoothPlastic, Parent = plot })
		part({ Name = "WallTrim", Size = V(1.1, 0.25, S.Z), CFrame = cf * CFrame.new(x, Map.FLOOR_Y + 3.1, 0), Color = wallC, Material = Enum.Material.Neon, Parent = plot })
	end
	part({ Name = "Wall", Size = V(S.X, 3, 1), CFrame = cf * CFrame.new(0, Map.FLOOR_Y + 1.5, S.Z / 2 - 0.5), Color = C(235, 240, 250), Material = Enum.Material.SmoothPlastic, Parent = plot })
	part({ Name = "WallTrim", Size = V(S.X, 0.25, 1.1), CFrame = cf * CFrame.new(0, Map.FLOOR_Y + 3.1, S.Z / 2 - 0.5), Color = wallC, Material = Enum.Material.Neon, Parent = plot })

	-- gate with the owner's name
	local gz = -S.Z / 2 + 0.5
	for _, x in { -9, 9 } do
		part({ Name = "GatePost", Size = V(1.6, 11, 1.6), CFrame = cf * CFrame.new(x, Map.FLOOR_Y + 5.5, gz), Color = C(60, 65, 80), Material = Enum.Material.Metal, Parent = plot })
		part({ Name = "GateLight", Size = V(1.7, 0.4, 1.7), CFrame = cf * CFrame.new(x, Map.FLOOR_Y + 11.2, gz), Color = wallC, Material = Enum.Material.Neon, Parent = plot })
	end
	local beam = part({ Name = "GateTop", Size = V(20, 2.2, 1.6), CFrame = cf * CFrame.new(0, Map.FLOOR_Y + 10, gz), Color = C(60, 65, 80), Material = Enum.Material.Metal, Parent = plot })
	local sign = Util.billboard(beam, UDim2.fromOffset(360, 90), V(0, 3.2, 0), 200)
	sign.Name = "Sign"
	local name = Util.label(sign, "EMPTY BASE", C(255, 255, 255), UDim2.fromScale(1, 1), UDim2.fromScale(0, 0))
	name.Name = "OwnerName"
	name.TextTransparency = 0.5

	-- collect pad
	local pcf = cf * CFrame.new(-13, Map.FLOOR_Y + 0.2, -21)
	local pad = cylinder(pcf, 6, 0.4, { Name = "CollectPad", Color = C(60, 255, 110), Material = Enum.Material.Neon, Parent = plot })
	cylinder(pcf * CFrame.new(0, -0.05, 0), 7, 0.3, { Name = "CollectRim", Color = C(245, 195, 60), Material = Enum.Material.Metal, Parent = plot })
	local pbb = Util.billboard(pad, UDim2.fromOffset(220, 110), V(0, 4.5, 0), 90)
	pbb.Name = "Info"
	Util.label(pbb, "COLLECT", C(255, 255, 255), UDim2.fromScale(1, 0.4), UDim2.fromScale(0, 0))
	local amount = Util.label(pbb, "$0", C(90, 255, 120), UDim2.fromScale(1, 0.6), UDim2.fromScale(0, 0.4))
	amount.Name = "Amount"

	-- new machine pad
	local scf = cf * CFrame.new(13, Map.FLOOR_Y + 0.2, -21)
	local shop = cylinder(scf, 6, 0.4, { Name = "MachinePad", Color = C(70, 150, 255), Material = Enum.Material.Neon, Parent = plot })
	cylinder(scf * CFrame.new(0, -0.05, 0), 7, 0.3, { Name = "MachineRim", Color = C(245, 195, 60), Material = Enum.Material.Metal, Parent = plot })
	local sbb = Util.billboard(shop, UDim2.fromOffset(240, 110), V(0, 4.5, 0), 90)
	sbb.Name = "Info"
	Util.label(sbb, "NEW MACHINE", C(255, 255, 255), UDim2.fromScale(1, 0.4), UDim2.fromScale(0, 0))
	local price = Util.label(sbb, "", C(120, 200, 255), UDim2.fromScale(1, 0.6), UDim2.fromScale(0, 0.4))
	price.Name = "Price"
	local buy = Instance.new("ProximityPrompt")
	buy.Name = "BuyMachine"
	buy.ActionText = "Buy Machine"
	buy.HoldDuration = 0.5
	buy.MaxActivationDistance = 8
	buy.RequiresLineOfSight = false
	buy:SetAttribute("OwnerOnly", true)
	buy.Parent = shop

	local tanks = Instance.new("Folder")
	tanks.Name = "Tanks"
	tanks.Parent = plot

	plot.Parent = workspace:WaitForChild("Plots")
	Map.buildSphere(plot, Config.sphereRadius(Config.StartMachines))
	for i = 1, Config.StartMachines do
		Map.buildTank(plot, i)
	end
	return plot
end

function Map.buildPlots(): { Model }
	local folder = Instance.new("Folder")
	folder.Name = "Plots"
	folder.Parent = workspace
	local plots = {}
	local idx = 0
	for _, side in { -1, 1 } do
		for _, x in Config.PlotXs do
			idx += 1
			local center = V(x, 0, side * Config.PlotZ)
			local cf = CFrame.lookAt(center, center + V(0, 0, -side))
			table.insert(plots, Map.buildPlot(idx, cf))
		end
	end
	return plots
end

-- Points a walker follows from the carpet into a base, to tank i.
function Map.pathToTank(plot: Model, i: number): { Vector3 }
	local cf = plot:GetPivot()
	local S = Config.PlotSize
	local side = (cf.Position.Z > 0) and 1 or -1
	local tl = Map.tankLocal(i)
	local inward = (tl.X < 0) and 1 or -1
	return {
		V(cf.Position.X, 0, side * 4),
		(cf * CFrame.new(0, 0, -S.Z / 2 - 3)).Position,
		(cf * CFrame.new(0, Map.FLOOR_Y, -S.Z / 2 + 6)).Position,
		(cf * CFrame.new(tl.X + inward * 7, Map.FLOOR_Y, tl.Z)).Position,
		(cf * CFrame.new(tl.X + inward * 3, Map.FLOOR_Y, tl.Z)).Position,
	}
end

function Map.spawnPoint(plot: Model): CFrame
	local cf = plot:GetPivot()
	return cf * CFrame.new(0, Map.FLOOR_Y + 3, -Config.PlotSize.Z / 2 + 4) * CFrame.Angles(0, math.pi, 0)
end

return Map
]]></ProtectedString></Properties></Item>
